# ~/.config/claudemaxxing/fleet.env — the ONE place tenant/fleet identity lives on a machine.
# Deployed by the private install-fleet.sh from deploy/fleet.env. A machine WITHOUT this file
# is a standalone client: hooks stay silent, no transport is spawned, fleet commands say
# "not configured". Format: KEY=VALUE, '#' comments, optional quotes, no shell expansion.
# Precedence per key: process environment > this file > empty.
CLAUDEMAXXING_SERVER_SSH=user@server.example.ts.net
CLAUDEMAXXING_SERVER_HOSTNAME=server
CLAUDEMAXXING_DASHBOARD_URL=https://server.example.ts.net:5555
CLAUDEMAXXING_NOTIFY_TARGET=telegram:<chat-id>:<thread-id>
CLAUDEMAXXING_NOTIFY_RELAY=user@server
CLAUDEMAXXING_LAN_PEER=server.example.ts.net

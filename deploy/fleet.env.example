# ~/.config/orchestratormaxxing/fleet.env — the ONE place tenant/fleet identity lives on a machine.
# Deployed by the private install-fleet.sh from deploy/fleet.env. A machine WITHOUT this file
# is a standalone client: hooks stay silent, no transport is spawned, fleet commands say
# "not configured". Format: KEY=VALUE, '#' comments, optional quotes, no shell expansion.
# Precedence per key: process environment > this file > empty.
ORCHESTRATORMAXXING_SERVER_SSH=user@server.example.ts.net
ORCHESTRATORMAXXING_SERVER_HOSTNAME=server
ORCHESTRATORMAXXING_DASHBOARD_URL=https://server.example.ts.net:5555
ORCHESTRATORMAXXING_NOTIFY_TARGET=telegram:<chat-id>:<thread-id>
ORCHESTRATORMAXXING_NOTIFY_RELAY=user@server
ORCHESTRATORMAXXING_LAN_PEER=server.example.ts.net
ORCHESTRATORMAXXING_OPERATOR_ALIASES="<operator-name>,<alt-spelling>"
ORCHESTRATORMAXXING_EARTH_SSH=user@laptop-host
ORCHESTRATORMAXXING_BRIEF_TARGET=telegram:<chat-id>:<thread-id>
ORCHESTRATORMAXXING_COGLOAD_BRIEF_TARGET=telegram:<chat-id>:<thread-id>

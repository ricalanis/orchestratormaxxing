<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  cogload nightly maintenance, macOS. launchd sibling of cogload-nightly.timer.

  Runs the SAME shared script as Linux, so digest/rotate/fleet-push behave
  identically on both. The 21:20 close precedes the operator's typical laptop close.
  A separate lightweight RunAtLoad job catches up digest/push after a shutdown.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudemaxxing.cogload-nightly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.config/claudemaxxing/cogload-nightly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>21</integer>
        <key>Minute</key><integer>20</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/cogload/nightly.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/cogload/nightly.log</string>
</dict>
</plist>

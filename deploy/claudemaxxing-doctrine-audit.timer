# SOURCE OF TRUTH: repo template deploy/claudemaxxing-doctrine-audit.timer. install.sh copies this
# to ~/.config/systemd/user/ (copy, NOT symlink; no substitution needed). Edit here, re-run
# ./install.sh.
#
# Fires the doctrine-contradiction-audit seeder on the 1st of each month at 09:00 local — the
# slowest clock in the harness, one tick above the weekly strategic brief. Monthly is the cap, not
# a preference: instruction surfaces drift on the timescale of rounds landing, not hours, and a
# faster audit would manufacture findings rather than discover them.
# Persistent=true → a missed run (machine off/asleep) fires on wake.
#
# Arming is opt-in / SELECT (install.sh only re-syncs an already-enabled timer):
#   systemctl --user enable --now claudemaxxing-doctrine-audit.timer
#   sudo loginctl enable-linger "$USER"   # once: so it fires without an active login
[Unit]
Description=claudemaxxing monthly doctrine-audit timer (1st of month, 09:00 local)

[Timer]
OnCalendar=*-*-01 09:00:00
Persistent=true

[Install]
WantedBy=timers.target

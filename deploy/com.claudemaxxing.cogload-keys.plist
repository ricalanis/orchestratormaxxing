<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  cogload collector, macOS. The launchd sibling of deploy/cogload-keys.service.

  LimitLoadToSessionType=Aqua is load-bearing: keystroke capture needs the GUI
  session, and TCC grants attach to the running binary. Running this from an SSH
  session would neither capture nor carry the Accessibility / Input Monitoring
  grants the user approved.

  System Settings only accepts an application bundle for these TCC grants; it
  rejects the venv's python symlink (and greys out the bare Mach-O executable).
  Launch the signed Python.app executable so the daemon has the exact identity
  the user granted. PYTHONPATH keeps dependencies isolated in cogload's venv.
  `cogload selftest` catches a missing/revoked grant instead of recording zeros.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudemaxxing.cogload-keys</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/Resources/Python.app/Contents/MacOS/Python</string>
        <string>__HOME__/.local/bin/cogload</string>
        <string>daemon</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__HOME__/.local/share/cogload/venv/lib/python3.13/site-packages</string>
        <key>PYTHONNOUSERSITE</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <!-- This measures work; it must never compete with it. -->
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/cogload/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/cogload/daemon.log</string>
</dict>
</plist>

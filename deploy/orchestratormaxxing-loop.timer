# SOURCE OF TRUTH: repo template deploy/orchestratormaxxing-loop.timer. install.sh copies this to
# ~/.config/systemd/user/ (copy, NOT symlink; no substitution needed). Edit here, re-run ./install.sh.
#
# Linux counterpart of the launchd StartCalendarInterval. Fires the daily 07:00 self-improve round.
# Persistent=true → if the machine was off/asleep at 07:00, the run happens on next boot (the
# systemd analogue of launchd running a missed StartCalendarInterval job on wake).
#
# Arming is opt-in (install.sh only re-syncs an already-enabled timer):
#   systemctl --user enable --now orchestratormaxxing-loop.timer
#   sudo loginctl enable-linger "$USER"   # once: so the timer fires without an active login
[Unit]
Description=orchestratormaxxing daily self-improve timer (07:00 local)

[Timer]
OnCalendar=*-*-* 07:00:00
Persistent=true

[Install]
WantedBy=timers.target

<?xml version="1.0" encoding="UTF-8"?>
<!-- SOURCE OF TRUTH: repo template deploy/com.claudemaxxing.loop.plist. install.sh substitutes
     __HOME__ and copies this to ~/Library/LaunchAgents/ (copy, NOT symlink). Edit here, re-run
     ./install.sh, which also reloads the agent IF it's already loaded (arming stays opt-in). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudemaxxing.loop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.config/claudemaxxing/loop-cron.sh</string>
    </array>

    <!-- Daily at 07:00 local. If the Mac is asleep at 07:00, launchd runs it on next wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Do not fire on load/login — only on the schedule. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Never let two runs overlap at the launchd level either. -->
    <key>AbandonProcessGroup</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/.config/claudemaxxing/loop-launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.config/claudemaxxing/loop-launchd.err.log</string>
</dict>
</plist>

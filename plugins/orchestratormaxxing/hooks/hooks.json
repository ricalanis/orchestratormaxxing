{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SOLPLAN_CHILD:-0}\" = 1 ] && exit 0; \"$HOME/.local/bin/warp-agent-recovery\" register-agent codex 2>/dev/null; \"$HOME/.local/bin/agent-tab-status\" idle 2>/dev/null; \"$HOME/.local/bin/warp-agent-event\" codex session_start 2>/dev/null; true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SOLPLAN_CHILD:-0}\" = 1 ] && exit 0; \"$HOME/.local/bin/codex-session-start\" 2>/dev/null; true",
            "timeout": 15,
            "statusMessage": "Loading bounded SessionStart context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SOLPLAN_CHILD:-0}\" = 1 ] && exit 0; \"$HOME/.local/bin/agent-tab-status\" working 2>/dev/null; \"$HOME/.local/bin/warp-agent-event\" codex prompt_submit 2>/dev/null; true",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SOLPLAN_CHILD:-0}\" = 1 ] && exit 0; \"$HOME/.local/bin/agent-tab-status\" attention 2>/dev/null; \"$HOME/.local/bin/warp-agent-event\" codex permission_request 2>/dev/null; \"$HOME/.local/bin/agent-done-notify\" --agent codex 2>/dev/null; true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input|AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SOLPLAN_CHILD:-0}\" = 1 ] && exit 0; \"$HOME/.local/bin/agent-tab-status\" attention 2>/dev/null; \"$HOME/.local/bin/warp-agent-event\" codex question_asked 2>/dev/null; \"$HOME/.local/bin/agent-done-notify\" --agent codex 2>/dev/null; true",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/agent-guard\" pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "request_user_input|AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SOLPLAN_CHILD:-0}\" = 1 ] && exit 0; \"$HOME/.local/bin/agent-tab-status\" working 2>/dev/null; \"$HOME/.local/bin/warp-agent-event\" codex permission_replied 2>/dev/null; true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/agent-guard\" post",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${SOLPLAN_CHILD:-0}\" = 1 ] && printf '{}\\n' && exit 0; \"$HOME/.local/bin/codex-stop-hook\"",
            "timeout": 15,
            "statusMessage": "Recording completion"
          }
        ]
      }
    ]
  }
}

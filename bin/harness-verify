        ("ticket-route", "tests/ticket-route/run.sh", "bin/ticket-route", 30),
        # Provider-capacity CLI: loopback Hermes fixture + fake official Codex
        # app-server protocol. No egress, tmux, credentials, or live provider state.
        ("capacity", "tests/capacity/run.sh", "bin/capacity", 15),
        # Chapter-18 token audit + loop-portfolio ledger. Fixture $HOME (so

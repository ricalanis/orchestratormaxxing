        # fixture repo, pinned clock. The load-bearing assertions discriminate
        # the two ways a plausible implementation reports success while
        # measuring nothing: inventorying only `mcpServers` (4 of 17 surfaces)
        # and counting a prose mention of a tool as a call.
        ("token-ledger", "tests/token-ledger/run.sh", "bin/token-ledger", 30),
        # The routing substrate. C5 and C6 are the load-bearing pair and both were
        # proven red before their guard landed: a low-N cell must OMIT
        # preferred_lane (not caveat it), and infra failures must stay out of the
        # pass_rate denominator so a transport hang can never demote a lane.
        ("delegate-ledger", "tests/delegate-ledger/run.sh", "bin/delegate-ledger", 30),
        # "The Hermes MCP is never public." C1 is the literal config this host ran
        # on 2026-08-16 with the 172-tool MCP surface funnelled to the open web —
        # so the red proof is history, not a hypothetical. C4 pins the gate's
        # scope: it forbids funnelling the MCP, not funnelling anything ever.
        ("tailnet-mcp-posture", "tests/tailnet-mcp-posture/run.sh", "bin/harness-verify", 20),
        # Established offline runtime is 1-2s; 10s retains a 5x margin while making
        # intermittent inability bounded enough for the SessionStart watcher.
        ("context-stateless", "tests/context-stateless/run.sh", "bin/oll", 10),
        ("oll-reasoning-effort", "tests/oll-reasoning-effort/run.sh", "bin/oll", 20),
        # oll must never block unbounded on an open-but-silent stdin: the hang
        # reads as a dead provider (exit 124, zero bytes) and got misfiled as
        # an argv-size transport bug (lq-e1fa0a69).
        ("oll-stdin-guard", "tests/oll-stdin-guard/run.sh", "bin/oll", 30),

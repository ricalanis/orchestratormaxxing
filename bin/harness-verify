        # The cross-machine daily lock, on REAL git: bare remotes, real pushes, a
        # real dirty-tree worktree round. Only the agent-side commands are faked.
        # Proven red against the pre-fix wrapper — it reproduced the actual
        # double-run (both machines fired the same day, lq-10d88328).
        ("loop-claim", "tests/loop-claim/run.sh", "deploy/loop-cron.sh", 30),
    ):
        if contract_id in FLEET_ONLY_CONTRACTS and not fleet_present:
            # The graduated public tree has no fleet half: the tool, its test, and the
            # installer that would ship it are all absent by design. Recorded as a visible
            # skip (never silently green) so a foreign machine can see what it is not measuring.
            contract_results.append({
                "id": contract_id, "outcome": "skipped", "where": where,
                "key": f"contract:{contract_id}:skipped",
                "attempts": [{"stderr_tail": "SKIP: fleet-only contract — install-fleet.sh absent "
                                             "(graduated core tree)"}],
            })
            continue
        result = run_contract_entry(root, contract_id, rel, where,
                                    timeout_seconds, err, warn)
        if result is not None:
            contract_results.append(result)

    # Executor transport: pane-addressed sends and a submit key the Codex TUI accepts.
    fn_contract("tmux-send-transport", tmux_send_transport_ok, "bin/tmux-send",
                ("bin/tmux-send",), prefix="transport regression")

    # Codex tmux helper: argument boundaries, exact targets, and fail-closed headless mode.
    fn_contract("codex-g", codex_g_behavior_ok, "shell/codex-g.sh",
                ("shell/codex-g.sh", "bin/harness-remote"))

    # OpenCode tmux helper: same contract as g, plus the occ-hardened one-shot path.
    fn_contract("opencode-o", opencode_o_behavior_ok, "shell/opencode-o.sh",
                ("shell/opencode-o.sh",))

    # Host-neutral memory: stable identity, atomic governed writes, migration,
    # Claude compatibility link, audit compatibility, and dirty-pull refusal.
    fn_contract("shared-memory", shared_memory_behavior_ok, "bin/memoryctl",
                ("bin/memoryctl", "bin/mem-audit", "bin/harness-sync"))

    # Deployed state: verify the artifacts that actually run, not only the repo copies.
    # Silent no-op when the harness is not installed on this machine.
    issues.extend(deployed_host_state_ok(root))
    issues.extend(tailnet_mcp_posture_ok(root))

    return issues, contract_results


def main():
    os.environ["ORCHESTRATORMAXXING_HARNESS_CHILD"] = "1"

    ap = argparse.ArgumentParser()
    ap.add_argument("--repo")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    root = repo_root(args.repo)
    issues, contract_results = audit(root)
    n_err = sum(1 for s, _, _ in issues if s == "error")
    n_warn = sum(1 for s, _, _ in issues if s == "warn")
    # Counted and printed on purpose: a contract that stopped being measurable must
    # be visible, not silently green (silence is not blindness).
    counts = contract_outcome_counts(contract_results)
    n_inconclusive = counts["inconclusive"]
    n_skipped = counts["skipped"]

    if args.json:
        print(json.dumps({
            "repo": root, "errors": n_err, "warnings": n_warn,
            "inconclusive": n_inconclusive,
            "skipped": n_skipped,
            "issues": [
                {"severity": s, "where": w, "message": m,
                 "key": f"issue:{w}:{m}"}
                for s, w, m in issues
            ],
            "contract_results": contract_results,
        }, indent=2))
    else:
        print(f"# harness-verify: {root}")
        print(f"# {n_err} error(s), {n_warn} warning(s), "
              f"{n_inconclusive} inconclusive, {n_skipped} skipped")
        if not issues and not n_inconclusive and not n_skipped:
            print("OK — harness green.")
        for sev, w, m in issues:
            mark = {"error": "✗", "warn": "⚠"}.get(sev, "·")
            print(f"{mark} [{sev}] {w}: {m}")
        for result in contract_results:
            if result.get("outcome") in {"recovered", "inconclusive", "skipped"}:
                stages = [a.get("last_stage") for a in result.get("attempts", [])]
                print(f"· [observation:{result['outcome']}] {result['id']}: "
                      f"{len(result['attempts'])} attempt(s), stages={stages}")
    sys.exit(1 if n_err else (2 if n_inconclusive else 0))


if __name__ == "__main__":
    main()

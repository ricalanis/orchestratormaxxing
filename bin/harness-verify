#!/usr/bin/env python3
"""harness-verify — deterministic self-check for the orchestratormaxxing harness itself.

This is the *verifier* for the self-improvement loop (Claude command + Codex plugin skill).
The research is explicit (Retrospective Harness Optimization, arXiv:2606.05922) that a
self-improving harness needs a regression guard, and our iron rule says the guard must be
DETERMINISTIC — never self-preference (the harness grading its own rewrite). This script is
that guard: it computes harness health from the filesystem + syntax checks, so the loop reads
only pass/fail, never re-derives "is this good" with an LLM.

It is the ETCLOVG (HarnessFix, arXiv:2606.06324) lint for THIS repo's support layers:
  Execution/Tool   — every bin/* tool parses, is executable, has a shebang
  Lifecycle/Govern — every tool + host adapter is wired into install.sh (deploy coverage)
  Context/Govern   — shared doctrine + Claude/Codex adapters keep load-bearing contracts
  Verification     — mem-audit + mut still run

Read-only. Exit 0 = green (safe to commit a harness change), 1 = a regression to fix.

Usage:
  bin/harness-verify                # verify the repo containing cwd
  bin/harness-verify --repo <path>  # verify an explicit repo root
  bin/harness-verify --json         # machine-readable
"""
import argparse, ast, json, os, re, shutil, signal, subprocess, sys, tempfile, time, tomllib

# Load-bearing doctrine CLAUDE.md must keep (substring match, case-insensitive).
# Mostly section headings; "different model family" is a content invariant — the
# critic-independence rule (correlated same-family evaluators ≠ independent votes).
REQUIRED_DOCTRINE = [
    "orchestrator pattern",
    "verifying worker output",
    "memory governance",
    "different model family",
    "codex adapter",
    # The 2026-08-12 re-entrancy incident: a verifier that can start an agent
    # session re-enters itself through that session's own SessionStart hook.
    # Keeping the rule stated is what stops it being reintroduced by a future
    # contract on any host.
    "the harness never re-enters itself",
]

# Ollama Cloud model ids confirmed RETIRED (HTTP 410 against /v1/chat/completions, 2026-07-16).
# A dispatch surface referencing one silently breaks every delegation that picks it — the
# stale-catalog flaw (lq-ae2fea2e). Exact-id match on purpose: substring family fallbacks
# (e.g. oll-sync's ctx_for) are inert and must not trip. Extend this list when a probe
# confirms a new retirement; prune an id if the catalog resurrects it.
RETIRED_MODELS = [
    "qwen3-coder:480b",
    "qwen3-coder-next",
    "qwen3-vl:235b",
]

# Host compaction knobs the harness must never pin. Every host ships its own calibrated
# compaction (Claude: a per-window precomputeBufferFraction table; Codex: 90% of the model's
# resolved context window, codex-rs protocol/src/openai_models.rs::auto_compact_token_limit),
# and we have no evidence any flat threshold beats it. CLAUDE_AUTOCOMPACT_PCT_OVERRIDE is
# Claude Code's internal *test-only* testPctOverride: setting it discards that table outright.
COMPACTION_OVERRIDE_KEYS = {
    "claude": ["CLAUDE_CODE_AUTO_COMPACT_WINDOW", "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE"],
    "codex": ["model_auto_compact_token_limit",
              "model_auto_compact_token_limit_scope",
              "experimental_compact_prompt_file"],
}


# Contract rows whose tool, test, and installer half all live only in the private fleet
# (install-fleet.sh). In the graduated public tree they are recorded as visible skips.
FLEET_ONLY_CONTRACTS = frozenset({
    "worker-path-bench", "tailnet-mcp-posture", "gpu-desktop",
    "ubuntu-launchers", "ubuntu-clipboard", "folder-sync", "project-new",
    "opendesign", "design-router", "firecrawl", "semantica",
    "install-fleet",
})

def compaction_override_msg(host, key):
    return (f"{key} overrides {host}'s native calibrated compaction — this harness settles on "
            "host defaults; remove the key (see knowledge/context-lifecycle.md)")


def repo_root(explicit):
    if explicit:
        return os.path.abspath(explicit)
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=10)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except Exception:
        pass
    return os.getcwd()


def syntax_ok(path):
    """Deterministic parse check by file type. Returns (ok, detail)."""
    if path.endswith(".py"):
        r = subprocess.run([sys.executable, "-m", "py_compile", path],
                           capture_output=True, text=True)
        return r.returncode == 0, r.stderr.strip().splitlines()[-1:] and r.stderr.strip().split("\n")[-1] or ""
    # treat everything else with a #! as the interpreter says; bash for sh/bash
    with open(path, "rb") as fh:
        head = fh.readline()
    if b"python" in head:
        r = subprocess.run([sys.executable, "-m", "py_compile", path], capture_output=True, text=True)
        return r.returncode == 0, (r.stderr.strip().split("\n")[-1] if r.returncode else "")
    if b"node" in head:
        node = shutil.which("node")
        if not node:
            return True, "(node not installed — not syntax-checked)"
        r = subprocess.run([node, "--check", path], capture_output=True, text=True)
        return r.returncode == 0, (r.stderr.strip().split("\n")[-1] if r.returncode else "")
    if b"bash" in head or b"/sh" in head or head.startswith(b"#!"):
        r = subprocess.run(["bash", "-n", path], capture_output=True, text=True)
        return r.returncode == 0, (r.stderr.strip().split("\n")[-1] if r.returncode else "")
    return True, "(no shebang — not syntax-checked)"


def _text(value):
    """TimeoutExpired may carry bytes even when Popen was opened in text mode."""
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return value


def _tail(value, limit=2048):
    return _text(value)[-limit:]


def _active_stage(trace_path):
    """Return the last unmatched BEGIN marker, or the last completed stage."""
    try:
        lines = open(trace_path, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return None
    stack = []
    last = None
    for line in lines[-256:]:
        kind, _, stage = line.partition(" ")
        stage = stage.strip()[:160]
        if not stage:
            continue
        if kind == "BEGIN":
            stack.append(stage)
            last = stage
        elif kind == "END":
            last = stage
            if stack and stack[-1] == stage:
                stack.pop()
    return stack[-1] if stack else last


def _process_snapshot(pgid):
    """Best-effort PID-only evidence; never capture argv or environment."""
    try:
        r = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,pgid=,stat="],
            capture_output=True, text=True, timeout=1,
        )
    except Exception:
        return []
    rows = []
    for line in r.stdout.splitlines():
        fields = line.split()
        if len(fields) < 4:
            continue
        try:
            pid, ppid, row_pgid = map(int, fields[:3])
        except ValueError:
            continue
        if row_pgid == pgid:
            rows.append({"pid": pid, "ppid": ppid, "pgid": row_pgid,
                         "state": fields[3][:16]})
    return rows[:32]


def _terminate_group(proc):
    """Bounded TERM→KILL cleanup for a contract and every descendant in its group."""
    if proc.poll() is not None:
        return "already-exited"
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return "already-exited"
    except OSError:
        proc.terminate()
    try:
        proc.wait(timeout=0.5)
    except subprocess.TimeoutExpired:
        pass
    # The leader may exit on TERM while a descendant ignores it. Probe the group itself;
    # waiting only for the leader would leak that child and falsely report clean termination.
    try:
        os.killpg(proc.pid, 0)
    except ProcessLookupError:
        return "term"
    else:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            return "term"
        except OSError:
            if proc.poll() is None:
                proc.kill()
        return "kill"


# Exit code a contract uses to say "precondition unmet — I could not be measured
# on this host" (the GNU/autotools SKIP convention; see tests/lib/precondition.sh).
# It is deliberately NOT a failure: an environment gap on one machine must not be
# enqueued as a harness flaw the other machine can never reproduce.
HARNESS_SKIP_EXIT = 77
# The exit code is only half the protocol: a skip must also SAY so on stderr,
# so a tool accidentally propagating 77 cannot silently stop being measured.
HARNESS_SKIP_MARKER = "SKIP:"


def _declares_skip(receipt_path, stderr):
    """True only when THIS contract's own precondition gate declared the skip.

    Returns a plain bool on purpose: the human-readable reason is read from the
    attempt's stderr tail by contract_issue(), so a richer return value here
    would be dead weight the mutation gate cannot discriminate.

    Three progressively tighter versions of this check, each forced by a critic:

      1. exit 77 alone — a contract under `set -e` propagating some tool's own
         77 would be laundered into "not measured here" instead of red.
      2. exit 77 + "SKIP:" anywhere in stderr — an incidental mention (a nested
         tool's warning, "ERROR: SKIP: retry later") would excuse measurement.
      3. exit 77 + a RECEIPT this verifier issued (below), plus the marker as
         the last non-empty stderr line.

    The receipt is what makes the declaration authenticated rather than inferred:
    run_behavioral_contract hands each attempt a private path in its own scratch
    directory via HARNESS_SKIP_RECEIPT, and only harness_need_cmd writes it.
    Text on a shared stream can be produced by any child process; a write to a
    path the verifier just invented cannot be produced by accident. Anything
    else fails in the safe direction — a failure, reported and enqueued.
    """
    if not os.path.exists(receipt_path):
        return False
    lines = [ln.strip() for ln in (stderr or "").splitlines() if ln.strip()]
    return bool(lines) and lines[-1].startswith(HARNESS_SKIP_MARKER)


def _pid_is_mut(mpid):
    """True when the pid's command line names mut (an argv token whose BASENAME
    is exactly `mut` — a substring match would honour `tmux`). Raised by both
    cross-family critics of lq-f8612b51: os.kill(pid, 0) proves A process
    lives, not that MUT lives, so a crashed run whose pid was recycled onto a
    long-lived process would blind the verifier indefinitely — and a forged
    lock could name any live pid. An UNINSPECTABLE pid (ps missing/erroring)
    is treated as mut: that fails toward a visible warn-skip, never toward
    measuring a possible live mutant as a red. A pid ps cannot find is dead."""
    try:
        out = subprocess.run(["ps", "-p", str(mpid), "-o", "args="],
                             capture_output=True, text=True, timeout=5)
    except Exception:
        return True
    if out.returncode != 0:
        return False
    return any(os.path.basename(tok) == "mut" for tok in out.stdout.split())


def mut_lock_live_pid(path):
    """Return the pid of the live bin/mut run holding <path>.mut-lock, else 0.

    A live bin/mut run rewrites the source in place per mutant, so the on-disk
    file is a mutant, not a regression — an artifact of measurement, not a
    signal (two false REDs on 2026-07-18 came from exactly this). A lock whose
    pid is dead, or alive but NOT a mut process (recycled/forged — see
    _pid_is_mut), is NOT honoured: mut cleans stale locks itself, and excusing
    measurement on a stale lock would let one crashed run blind this verifier
    forever (the .mut-orig check below stays the error for that case).
    Residual, stated not hidden: a lock naming a genuinely live mut run on a
    DIFFERENT file still skips (the lock is per-src, so only deliberate misuse
    produces that), and the check-then-run window is a per-pass transient,
    self-correcting on the next pass — the flaw fixed here was persistent.
    """
    lockp = path + ".mut-lock"
    if not os.path.exists(lockp):
        return 0
    try:
        mpid = int(open(lockp).read().strip() or "0")
    except (OSError, ValueError):
        return 0
    if not mpid:
        return 0
    try:
        os.kill(mpid, 0)
    except ProcessLookupError:
        return 0
    except PermissionError:
        pass
    return mpid if _pid_is_mut(mpid) else 0


def contract_issue(result):
    """Map one contract result to (severity, message), or None when there is nothing to report.

    The distinction this function exists for: `failed` means the contract RAN and the
    target did the wrong thing (an error — the guard is red). `skipped` means the
    contract could not run here at all, because a dependency it needs is absent
    (a warning naming that dependency). Collapsing the second into the first is
    what put three unreproducible Mac-only "tmux missing" rows in the flaw queue
    while the Ubuntu baseline was 0 errors.
    """
    outcome = result.get("outcome")
    if outcome not in {"failed", "skipped"}:
        return None
    attempts = result.get("attempts") or [{}]
    attempt = attempts[-1] or {}
    detail = (attempt.get("stderr_tail") or attempt.get("stdout_tail") or "").strip()
    lines = [ln for ln in detail.splitlines() if ln.strip()]
    detail = lines[-1] if lines else "unknown failure"
    if outcome == "skipped":
        return ("warn", f"behavioral contract skipped: {detail}")
    return ("error", f"behavioral contract failed: {detail}")


def record_contract_result(result, where, err, warn):
    """Route one contract result to the right severity sink. Extracted so the
    routing itself is testable: a skip reaching `err` is exactly how a
    machine-local environment gap becomes a permanently queued harness flaw,
    and the dispatch loop is not otherwise exercised by any contract."""
    reported = contract_issue(result)
    if not reported:
        return None
    severity, message = reported
    (err if severity == "error" else warn)(where, message)
    return (severity, message)


def run_contract_entry(root, contract_id, rel, where, timeout_seconds, err, warn):
    """Run one registered behavioral contract, honouring the mut-lock liveness skip.

    Extracted so the skip is testable. The liveness skip above covered only the
    SYNTAX check, so a live bin/mut run on a tool still ran that tool's
    behavioral contract against whatever mutant was on disk — flipping the
    verifier red/green per mutant (lq-f8612b51, observed 2026-08-19 with an
    orphaned mut cycling bin/delegate-ledger: one full pass green, the next
    red inside the live mutant's traceback). Ordering is deliberate: a missing
    contract FILE stays an error even under a live lock (a structural gap must
    not be masked by a transient one), and a stale/dead lock never excuses
    measurement (mut_lock_live_pid returns 0 for it).

    Returns the contract result dict, or None when only the missing-file error
    applies. The skip result rides the same skipped/warn machinery as the
    host-dependency SKIP protocol, so it is counted, printed, and never enqueued.
    """
    contract = os.path.join(root, rel)
    if not os.path.isfile(contract):
        err(where, f"behavioral contract missing: {rel}")
        return None
    mpid = mut_lock_live_pid(os.path.join(root, where))
    if mpid:
        result = {
            "id": contract_id,
            "outcome": "skipped",
            "key": f"contract:{contract_id}:skipped",
            "attempts": [{"stderr_tail":
                          f"SKIP: mut run in progress on {where} (pid {mpid}) — "
                          "behavioral contract skipped this pass"}],
        }
    else:
        result = run_behavioral_contract(
            contract_id, ["bash", contract], timeout_seconds=timeout_seconds,
            retry_observer=True,
        )
    result["where"] = where
    result["path"] = rel
    record_contract_result(result, where, err, warn)
    return result


def run_function_contract(root, contract_id, fn, where, tools, err, warn,
                          prefix="behavioral contract failed"):
    """Dispatch one FUNCTION-based behavioral contract, honouring the same
    mut-lock liveness skip as run_contract_entry (lq-5b64d4bf).

    run_contract_entry covers the tuple-registered contracts, but the in-process
    function contracts (loop_tools_behavior_ok and friends) hardcoded their
    tools and bypassed the skip — a live bin/mut run on e.g. bin/loop-queue
    still flipped those verdicts per mutant. `tools` names every repo-relative
    tool the function actually drives, including transitive ones (loop-tick
    shells out to loop-queue), because the mutant that flips a contract need
    not be its headline tool. Fake/stubbed dependencies are deliberately NOT
    listed (opencode_o stubs occ, so a mutated bin/occ cannot reach it).

    Returns the skip result dict (for contract_results, so the skip is counted
    and printed like any other) or None when the function ran — its failure
    strings ride `err` directly, exactly as before.
    """
    for rel in tools:
        mpid = mut_lock_live_pid(os.path.join(root, rel))
        if mpid:
            result = {
                "id": contract_id,
                "outcome": "skipped",
                "key": f"contract:{contract_id}:skipped",
                "attempts": [{"stderr_tail":
                              f"SKIP: mut run in progress on {rel} (pid {mpid}) — "
                              "behavioral contract skipped this pass"}],
                "where": where,
                "path": rel,
            }
            record_contract_result(result, where, err, warn)
            return result
    for msg in fn(root):
        err(where, f"{prefix}: {msg}")
    return None


def contract_outcome_counts(contract_results):
    """Count the contract outcomes that are neither pass nor error.

    `skipped` is counted for the same reason it is printed: an environment that
    quietly stopped measuring must be visible, not green.
    """
    return {
        "inconclusive": sum(1 for r in contract_results
                            if r.get("outcome") == "inconclusive"),
        "skipped": sum(1 for r in contract_results
                       if r.get("outcome") == "skipped"),
    }


def run_behavioral_contract(contract_id, command, *, timeout_seconds=30,
                            retry_observer=True, extra_env=None, scratch_parent=None):
    """Run one contract and distinguish target failure from inability to observe it.

    Only `timeout` and `observer_error` earn one targeted retry. A measured nonzero exit is
    never retried. Evidence is bounded and the per-run trace directory is always removed.
    """
    scratch = tempfile.mkdtemp(prefix=f"harness-contract-{contract_id}-",
                               dir=scratch_parent)
    attempts = []
    try:
        limit = 2 if retry_observer else 1
        for number in range(1, limit + 1):
            trace_path = os.path.join(scratch, f"attempt-{number}.trace")
            skip_receipt = os.path.join(scratch, f"attempt-{number}.skip")
            env = dict(os.environ)
            env.update(extra_env or {})
            # Set after extra_env so no caller can clear it: every contract, and
            # everything a contract spawns, runs marked as a harness child. This
            # is what stops a contract from starting an agent session whose
            # SessionStart hook re-enters this verifier (incident 2026-08-12).
            env["ORCHESTRATORMAXXING_HARNESS_CHILD"] = "1"
            env["HARNESS_CONTRACT_ATTEMPT"] = str(number)
            env["HARNESS_TRACE_FILE"] = trace_path
            # Private, per-attempt, invented by this verifier: the only thing a
            # contract can write that proves the skip came from its own gate.
            env["HARNESS_SKIP_RECEIPT"] = skip_receipt
            started = time.monotonic()
            attempt = {
                "attempt": number,
                "timeout_seconds": timeout_seconds,
                "outcome": "observer_error",
                "returncode": None,
                "duration_ms": 0,
                "last_stage": None,
                "stdout_tail": "",
                "stderr_tail": "",
                "pid": None,
                "pgid": None,
                "termination": None,
                "process_snapshot": [],
            }
            try:
                proc = subprocess.Popen(
                    command, stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    text=True, env=env, start_new_session=True,
                )
                attempt["pid"] = proc.pid
                attempt["pgid"] = proc.pid
                try:
                    stdout, stderr = proc.communicate(timeout=timeout_seconds)
                    attempt["returncode"] = proc.returncode
                    if proc.returncode == 0:
                        attempt["outcome"] = "pass"
                    elif (proc.returncode == HARNESS_SKIP_EXIT
                          and _declares_skip(skip_receipt, stderr)):
                        # Both halves are load-bearing. The exit code alone is
                        # forgeable by accident: a contract under `set -e` can
                        # propagate a tool's own 77 and would then read as
                        # "not measured here" instead of red. Requiring the
                        # marker its stderr means only a DELIBERATE skip from
                        # harness_need_cmd is honoured; anything else fails in
                        # the safe direction.
                        attempt["outcome"] = "skipped"
                    else:
                        attempt["outcome"] = "failure"
                except subprocess.TimeoutExpired as ex:
                    attempt["outcome"] = "timeout"
                    attempt["process_snapshot"] = _process_snapshot(proc.pid)
                    attempt["termination"] = _terminate_group(proc)
                    drained = True
                    try:
                        stdout, stderr = proc.communicate(timeout=1)
                    except subprocess.TimeoutExpired:
                        drained = False
                        stdout, stderr = ex.stdout, ex.stderr
                    attempt["returncode"] = proc.returncode
                    # Deadline-vs-clean-exit race (lq-258f3a34): a leader that
                    # exited 0 before any signal was sent, with pipes drained
                    # clean and its whole process group gone, ran to completion
                    # on its own — the parent's deadline raced the child's
                    # clean exit, so this is a pass. All FOUR conditions are
                    # load-bearing: a hung child that traps SIGTERM and exits 0
                    # gets termination "term"/"kill"; a clean leader hiding a
                    # live pipe-holding descendant fails the drain; one hiding
                    # a detached daemon fails the group probe. All must stay
                    # timeouts. (Group-id recycling can only fail toward
                    # timeout — the safe direction.)
                    try:
                        os.killpg(proc.pid, 0)
                        group_alive = True
                    except ProcessLookupError:
                        group_alive = False
                    except OSError:
                        group_alive = True
                    if (drained and not group_alive
                            and attempt["termination"] == "already-exited"
                            and attempt["returncode"] == 0):
                        attempt["outcome"] = "pass"
                attempt["stdout_tail"] = _tail(stdout)
                attempt["stderr_tail"] = _tail(stderr)
            except Exception as ex:
                attempt["stderr_tail"] = _tail(f"{type(ex).__name__}: {ex}")
            attempt["duration_ms"] = round((time.monotonic() - started) * 1000)
            attempt["last_stage"] = _active_stage(trace_path)
            attempts.append(attempt)

            if attempt["outcome"] in {"pass", "failure", "skipped"}:
                break

        outcomes = [a["outcome"] for a in attempts]
        if outcomes == ["pass"]:
            outcome = "passed"
        elif outcomes[-1] == "pass":
            outcome = "recovered"
        elif outcomes[-1] == "failure":
            outcome = "failed"
        elif outcomes[-1] == "skipped":
            outcome = "skipped"
        else:
            outcome = "inconclusive"
        return {
            "id": contract_id,
            "outcome": outcome,
            "key": f"contract:{contract_id}:{outcome}",
            "attempts": attempts,
        }
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def loop_tools_behavior_ok(root):
    """Behavioral self-test for the loop tools — the gap syntax-checks can't cover.

    harness-verify already parses every bin/* tool, but syntax-green does NOT prove the
    queue's load-bearing CONTRACTS hold, and the whole event-driven loop rides on two of them:
      • the gate exit code  — `loop-queue status --gate` exits 0 iff a non-research open flaw
                              exists (research leads alone stay idle), else 1
      • idempotent add       — re-adding the same content hash must NOT duplicate
    A regression in either passes the existing guard silently while firing dry rounds or
    flooding the queue. So drive loop-queue as a BLACK BOX against a throwaway queue dir
    (LOOP_QUEUE_DIR) and assert the contracts. Deterministic (no LLM), isolated (never touches
    the real knowledge/loop-queue.jsonl), self-cleaning. Returns a list of failure strings
    (empty = pass) — Opus/the loop reads only those, never re-derives correctness.
    """
    lq = os.path.join(root, "bin", "loop-queue")
    if not os.path.isfile(lq):
        return []  # absence is handled by the Execution/Tool layer; nothing to exercise here
    interp = [sys.executable] if "python" in open(lq).readline() else []
    tmp = tempfile.mkdtemp(prefix="hv-loopq-")
    env = dict(os.environ, LOOP_QUEUE_DIR=tmp, LOOP_QUEUE_TS="2026-01-01T00:00:00Z")

    def lq_run(*a):
        return subprocess.run([*interp, lq, *a], capture_output=True, text=True, env=env, timeout=30)

    def open_count():
        try:
            return json.loads(lq_run("status", "--json").stdout or "{}").get("open")
        except ValueError:
            return None

    fails = []
    try:
        # gate is IDLE (exit 1) on an empty queue
        if lq_run("status", "--gate").returncode != 1:
            fails.append("gate exit code wrong on empty queue (expected 1=idle)")
        # first add succeeds and creates exactly one open item
        if lq_run("add", "--layer", "V", "--source", "manual", "hv selftest flaw").returncode != 0:
            fails.append("add did not exit 0")
        if open_count() != 1:
            fails.append("open count != 1 after first add")
        # gate flips to ACT (exit 0) once there is open work
        if lq_run("status", "--gate").returncode != 0:
            fails.append("gate exit code wrong with open>0 (expected 0=act)")
        # idempotent: re-adding the same flaw must NOT duplicate
        lq_run("add", "--layer", "V", "--source", "manual", "hv selftest flaw")
        if open_count() != 1:
            fails.append("idempotent add duplicated (open count != 1 after re-add)")
        # resolving all open items drains the gate back to IDLE.
        # `status` just reported open>0, so `list` MUST agree — an empty list here is itself a
        # status/list contract violation, not a reason to skip the resolve/recurrence asserts.
        opens = json.loads(lq_run("list", "--status", "open", "--json").stdout or "[]")
        if not opens:
            fails.append("list --status open returned [] while status reported open>0 (status/list disagree)")
        else:
            lq_run("resolve", opens[0]["id"])
            if lq_run("status", "--gate").returncode != 1:
                fails.append("gate did not return to idle (1) after resolving all items")
            # recurrence (dedup's other half): re-adding a RESOLVED flaw reopens it, flagged
            lq_run("add", "--layer", "V", "--source", "manual", "hv selftest flaw")
            reopened = json.loads(lq_run("list", "--status", "open", "--json").stdout or "[]")
            if not (len(reopened) == 1 and reopened[0].get("recurred")):
                fails.append("re-adding a resolved flaw did not reopen with recurred=True")
        # ACTIONABILITY EXCLUDES RESEARCH LEADS (loop-engineering: act on real signal only).
        # A `research`-source open lead must NOT flip the gate to ACT, else harness-scan intake
        # manufactures dry, reward-hack-prone rounds. A real (non-research) flaw alongside it
        # still must. Isolated against its own throwaway queue dir.
        tmp2 = tempfile.mkdtemp(prefix="hv-loopq-r-")
        env2 = dict(os.environ, LOOP_QUEUE_DIR=tmp2, LOOP_QUEUE_TS="2026-01-01T00:00:00Z")
        def lq2(*a):
            return subprocess.run([*interp, lq, *a], capture_output=True, text=True, env=env2, timeout=30)
        try:
            lq2("add", "--layer", "G", "--source", "research", "research lead: paper — does our harness do this?")
            st = json.loads(lq2("status", "--json").stdout or "{}")
            if st.get("open") != 1:
                fails.append("research add did not create exactly one open item")
            if st.get("actionable") != 0:
                fails.append("research lead counted as actionable (expected 0 — research must not fire rounds)")
            if lq2("status", "--gate").returncode != 1:
                fails.append("gate fired ACT on a research-only queue (expected 1=idle)")
            lq2("add", "--layer", "V", "--source", "manual", "real flaw alongside research")
            if lq2("status", "--gate").returncode != 0:
                fails.append("gate stayed idle with a non-research open flaw present (expected 0=act)")
        finally:
            shutil.rmtree(tmp2, ignore_errors=True)
    except Exception as ex:
        fails.append(f"loop-queue self-test crashed: {ex}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return fails


def loop_queue_ttl_ok(root):
    """Behavioral self-test for the queue's TTL sweep — a DESTRUCTIVE op on the forward state.

    `loop-queue expire` is the drain side of research backpressure: without it, untriaged leads
    accumulate until `slots = cap - open` pins at 0 and `loop-tick` stops pulling external
    research entirely — silently, with harness-verify green (that is exactly how intake died
    2026-07-17..2026-08-08, lq-8962bc1c). But a sweep that resolves items is the one place the
    queue can LOSE signal, so the boundary is asserted, not trusted:
      • age gate      — only leads strictly older than the TTL go; younger ones survive
      • source gate   — a non-research flaw of the SAME age is never swept, and `--source manual`
                        is REFUSED (exit 2), so real signal cannot be aged out even on request
      • claimed gate  — a claimed lead is held (someone is working it)
      • dry-run       — reports without writing
      • recurrence    — re-adding an EXPIRED lead must NOT flag ⚠RECURRED; that flag means "a fix
                        regressed" and routine research churn must not dilute it
    Black box against a throwaway LOOP_QUEUE_DIR, with LOOP_QUEUE_TS driving both the add stamp
    and 'now' so age is deterministic. Never touches the real queue. Empty list = pass.
    """
    lq = os.path.join(root, "bin", "loop-queue")
    if not os.path.isfile(lq):
        return []  # absence is handled by the Execution/Tool layer
    interp = [sys.executable] if "python" in open(lq).readline() else []
    tmp = tempfile.mkdtemp(prefix="hv-loopttl-")
    fails = []

    def at(ts, *a):
        env = dict(os.environ, LOOP_QUEUE_DIR=tmp, LOOP_QUEUE_TS=ts)
        return subprocess.run([*interp, lq, *a], capture_output=True, text=True,
                              env=env, timeout=30)

    def opens(ts="2026-03-01T00:00:00Z"):
        try:
            return json.loads(at(ts, "list", "--status", "open", "--json").stdout or "[]")
        except ValueError:
            return []

    try:
        OLD, NEW, NOW = "2026-01-01T00:00:00Z", "2026-02-25T00:00:00Z", "2026-03-01T00:00:00Z"
        at(OLD, "add", "--layer", "G", "--source", "research", "ttl old lead")
        at(NEW, "add", "--layer", "G", "--source", "research", "ttl fresh lead")
        at(OLD, "add", "--layer", "V", "--source", "harness-verify", "ttl real flaw same age")
        at(OLD, "add", "--layer", "C", "--source", "research", "ttl claimed lead")
        claimed = [it for it in opens() if it.get("flaw") == "ttl claimed lead"]
        if claimed:
            at(NOW, "claim", claimed[0]["id"])

        # --dry-run reports the sweep without mutating the queue
        before = {it["id"] for it in opens()}
        dry = at(NOW, "expire", "--days", "30", "--dry-run", "--json")
        try:
            dryn = json.loads(dry.stdout or "{}").get("count")
        except ValueError:
            dryn = None
        if dryn != 1:
            fails.append(f"dry-run should report exactly 1 expirable lead, reported {dryn}")
        if {it["id"] for it in opens()} != before:
            fails.append("--dry-run mutated the queue")

        # a non-expirable source must be REFUSED outright (exit 2), not silently swept
        ref = at(NOW, "expire", "--source", "manual", "--days", "30")
        if ref.returncode != 2:
            fails.append(f"expire --source manual should refuse with exit 2, got {ref.returncode}")
        if {it["id"] for it in opens()} != before:
            fails.append("refused expire still mutated the queue")

        if at(NOW, "expire", "--days", "30").returncode != 0:
            fails.append("expire did not exit 0")
        left = {it.get("flaw") for it in opens()}
        if "ttl old lead" in left:
            fails.append("stale research lead survived the TTL sweep (intake stays deadlocked)")
        if "ttl fresh lead" not in left:
            fails.append("fresh research lead was expired before its TTL")
        if "ttl real flaw same age" not in left:
            fails.append("NON-research flaw of the same age was expired — real signal lost")
        allitems = json.loads(at(NOW, "list", "--status", "all", "--json").stdout or "[]")
        if not any(it.get("flaw") == "ttl claimed lead" and it.get("status") == "claimed"
                   for it in allitems):
            fails.append("claimed research lead was expired (a held item must not be swept)")

        # an expired lead re-surfacing is ordinary intake, not a regressed fix
        at(NOW, "add", "--layer", "G", "--source", "research", "ttl old lead")
        again = [it for it in opens() if it.get("flaw") == "ttl old lead"]
        if not again:
            fails.append("re-adding an expired lead did not reopen it")
        elif again[0].get("recurred"):
            fails.append("re-added EXPIRED lead flagged ⚠RECURRED (dilutes the regression signal)")
    except Exception as ex:
        fails.append(f"loop-queue TTL self-test crashed: {ex}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return fails


def intent_queue_behavior_ok(root):
    """Behavioral self-test for intent-queue — the proactive layer's forward-state contracts.

    intent-queue is loop-queue's business-scoped sibling (proactive layer). Syntax-green does NOT
    prove its load-bearing contracts hold, and the proactive round rides on them:
      • gate exit code   — `status --gate` exits 0 iff an open intent exists, else 1
      • idempotent add    — re-adding the same (kind, intent) must NOT duplicate
      • dismiss is sticky  — a dismissed intent must NOT be re-added (respecting Ricardo's 'no',
                             else the watcher re-nags every session — the proactive-fatigue failure)
    A regression passes the existing guard silently while double-proposing or re-nagging. Drive it
    as a BLACK BOX against a throwaway queue dir (INTENT_QUEUE_DIR). Deterministic, isolated,
    self-cleaning. Returns failure strings (empty = pass).
    """
    iq = os.path.join(root, "bin", "intent-queue")
    if not os.path.isfile(iq):
        return []  # absence handled by the Execution/Tool layer
    interp = [sys.executable] if "python" in open(iq).readline() else []
    tmp = tempfile.mkdtemp(prefix="hv-intentq-")
    env = dict(os.environ, INTENT_QUEUE_DIR=tmp, INTENT_QUEUE_TS="2026-01-01T00:00:00Z")

    def run(*a):
        return subprocess.run([*interp, iq, *a], capture_output=True, text=True, env=env, timeout=30)

    def open_count():
        try:
            return json.loads(run("status", "--json").stdout or "{}").get("open")
        except ValueError:
            return None

    fails = []
    try:
        if run("status", "--gate").returncode != 1:
            fails.append("gate exit code wrong on empty queue (expected 1=idle)")
        if run("add", "score the unscored leads", "--kind", "unscored-leads",
               "--source", "hermes-watch").returncode != 0:
            fails.append("add did not exit 0")
        if open_count() != 1:
            fails.append("open count != 1 after first add")
        if run("status", "--gate").returncode != 0:
            fails.append("gate exit code wrong with open>0 (expected 0=act)")
        # idempotent: re-adding the same (kind, intent) must NOT duplicate
        run("add", "score the unscored leads", "--kind", "unscored-leads", "--source", "hermes-watch")
        if open_count() != 1:
            fails.append("idempotent add duplicated (open count != 1 after re-add)")
        # dismiss is sticky: a dismissed intent must NOT come back on re-add (no re-nag)
        opens = json.loads(run("list", "--status", "open", "--json").stdout or "[]")
        if not opens:
            fails.append("list --status open returned [] while status reported open>0 (status/list disagree)")
        else:
            run("dismiss", opens[0]["id"])
            if run("status", "--gate").returncode != 1:
                fails.append("gate did not return to idle (1) after dismissing the only intent")
            run("add", "score the unscored leads", "--kind", "unscored-leads", "--source", "hermes-watch")
            if open_count() not in (0, None):
                fails.append("re-adding a DISMISSED intent re-opened it (proactive re-nag — dismiss must be sticky)")
    except Exception as ex:
        fails.append(f"intent-queue self-test crashed: {ex}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return fails


def session_log_behavior_ok(root):
    """Behavioral self-test for session-log — the contracts the Stop/SessionStart hooks ride on.

    Syntax-green does NOT prove: changelog prepends newest-first, the archive ROLLS past the
    keep-cap (else docs/changelog.md grows unbounded and the SessionStart tail stops being cheap),
    WIP overwrites (sticky, not append), and `check` is both correct AND opt-in (silent on
    non-adopted repos — else the global Stop hook nags every throwaway/cloned repo). Drive it as a
    BLACK BOX: Part A against a throwaway SESSION_LOG_DIR, Part B against a real temp git repo for
    the staleness gate. Deterministic (no LLM), isolated, self-cleaning. Returns failure strings.
    """
    sl = os.path.join(root, "bin", "session-log")
    if not os.path.isfile(sl):
        return []  # absence handled by the Execution/Tool layer
    interp = [sys.executable] if "python" in open(sl).readline() else []
    fails = []

    # --- Part A: changelog prepend + archive roll + WIP overwrite (docs-dir override) ---
    docs = tempfile.mkdtemp(prefix="hv-sl-")
    env = dict(os.environ, SESSION_LOG_DIR=docs, SESSION_LOG_KEEP="2", SESSION_LOG_TS="2026-06-01 00:00")
    def sl_run(*a, **kw):
        return subprocess.run([*interp, sl, *a], capture_output=True, text=True, env=env, timeout=30, **kw)
    try:
        sl_run("changelog", "first entry", "--tag", "feat")
        sl_run("changelog", "second entry", "--tag", "fix")
        tail = sl_run("tail").stdout
        if "first entry" not in tail or "second entry" not in tail:
            fails.append("tail missing changelog entries")
        elif tail.index("second entry") > tail.index("first entry"):
            fails.append("changelog not newest-first (prepend contract broken)")
        # a third entry exceeds KEEP=2 → the oldest must roll to the archive
        sl_run("changelog", "third entry")
        live = open(os.path.join(docs, "changelog.md")).read()
        n_live = sum(1 for l in live.splitlines() if l.startswith("## "))
        if n_live != 2:
            fails.append(f"archive roll wrong: live changelog has {n_live} entries (expected 2)")
        arch = os.path.join(docs, "changelog-archive")
        archived = ("".join(open(os.path.join(arch, f)).read() for f in os.listdir(arch))
                    if os.path.isdir(arch) else "")
        if "first entry" not in archived:
            fails.append("oldest entry not moved to archive on roll")
        # WIP must overwrite, not append
        sl_run("wip", "set", input="state one")
        sl_run("wip", "set", input="state two")
        wip = sl_run("wip", "show").stdout
        if "state two" not in wip or "state one" in wip:
            fails.append("WIP did not overwrite (sticky-overwrite contract broken)")
    except Exception as ex:
        fails.append(f"session-log changelog/wip self-test crashed: {ex}")
    finally:
        shutil.rmtree(docs, ignore_errors=True)

    # --- Part B: `check` staleness gate + opt-in (real temp git repo; no SESSION_LOG_DIR) ---
    repo = tempfile.mkdtemp(prefix="hv-sl-git-")
    genv = dict(os.environ, SESSION_LOG_TS="2026-06-02 00:00", GIT_AUTHOR_NAME="t",
                GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
    genv.pop("SESSION_LOG_DIR", None)  # check must resolve docs under the git root
    def g(*a):
        return subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True, env=genv, timeout=30)
    def sl_in(*a):
        return subprocess.run([*interp, sl, *a], capture_output=True, text=True, env=genv, cwd=repo, timeout=30)
    def stale():
        try:
            return json.loads(sl_in("check", "--json").stdout or "{}").get("stale")
        except ValueError:
            return None
    def write(name, body):
        with open(os.path.join(repo, name), "w") as fh:
            fh.write(body)
    try:
        if g("init").returncode != 0:
            raise RuntimeError("git init failed (git unavailable)")
        write("app.py", "v1\n"); g("add", "-A"); g("commit", "-m", "init")
        write("app.py", "v2\n")  # dirty, but project not adopted yet
        if stale() is not False:
            fails.append("check stale on a non-adopted project (opt-in broken — would nag every repo)")
        sl_in("changelog", "adopt"); g("add", "-A"); g("commit", "-m", "adopt")
        write("app.py", "v3\n")   # adopted + source changed, log untouched
        if stale() is not True:
            fails.append("check not stale after an adopted project changed source without logging")
        sl_in("changelog", "logged v3")
        if stale() is not False:
            fails.append("check still stale after logging the change")
    except Exception as ex:
        fails.append(f"session-log check self-test crashed: {ex}")
    finally:
        shutil.rmtree(repo, ignore_errors=True)
    return fails


def loop_tick_persistence_ok(root):
    """Black-box: queue policy distinguishes failures from observation anomalies.

    The SessionStart watcher enqueues harness-verify errors into the forward queue. A single
    TRANSIENT red — a tool mid-edit during the wrapper's pre-round rebase, a file caught between
    writes, a flaky external call — must NOT become a permanent queued flaw: that manufactures a
    dry investigative round (the reward-hack the loop is engineered to avoid; it cost a real round
    on 2026-07-13, lq-bc83c961). Contract: a red that clears on immediate re-check is dropped; a
    red present on two consecutive runs is enqueued. A recovered targeted timeout is diagnostic
    only; two targeted timeouts enqueue one stable O flaw; an unreadable verifier is retried and
    likewise names the observer, never its target. Drive the real loop-tick against fake tools.
    Deterministic (a counter file, no timing), isolated, self-cleaning. Returns failure strings.
    """
    lt = os.path.join(root, "bin", "loop-tick")
    if not os.path.isfile(lt):
        return []  # absence handled by the Execution/Tool layer
    fails = []

    FLAP = (  # red on odd calls, green on even → a transient that clears on the re-check
        '#!/usr/bin/env python3\n'
        'import json, os\n'
        'c = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".hv-count")\n'
        'n = (int(open(c).read()) if os.path.isfile(c) else 0) + 1\n'
        'open(c, "w").write(str(n))\n'
        'iss = [{"severity":"error","where":"bin/x","message":"flap"}] if n % 2 == 1 else []\n'
        'print(json.dumps({"errors":len(iss),"warnings":0,"issues":iss}))\n'
    )
    PERSIST = (  # red on every call → a real, persistent flaw
        '#!/usr/bin/env python3\n'
        'import json\n'
        'print(json.dumps({"errors":1,"warnings":0,'
        '"issues":[{"severity":"error","where":"bin/x","message":"persist"}]}))\n'
    )
    RECOVERED = (
        '#!/usr/bin/env python3\nimport json\n'
        'r={"id":"context-stateless","outcome":"recovered",'
        '"key":"contract:context-stateless:recovered","attempts":['
        '{"attempt":1,"outcome":"timeout","last_stage":"missing-auth-offline"},'
        '{"attempt":2,"outcome":"pass","last_stage":"suspended-provider"}]}\n'
        'print(json.dumps({"errors":0,"warnings":0,"inconclusive":0,'
        '"issues":[],"contract_results":[r]}))\n'
    )
    INCONCLUSIVE = (
        '#!/usr/bin/env python3\nimport json\n'
        'r={"id":"context-stateless","outcome":"inconclusive",'
        '"key":"contract:context-stateless:inconclusive","attempts":['
        '{"attempt":1,"outcome":"timeout","last_stage":"missing-auth-offline"},'
        '{"attempt":2,"outcome":"timeout","last_stage":"minimal-path-provider"}]}\n'
        'print(json.dumps({"errors":0,"warnings":0,"inconclusive":1,'
        '"issues":[],"contract_results":[r]}))\n'
    )
    MIXED = (
        '#!/usr/bin/env python3\nimport json, os\n'
        'c=os.path.join(os.path.dirname(os.path.abspath(__file__)), ".hv-count")\n'
        'n=(int(open(c).read()) if os.path.isfile(c) else 0)+1\nopen(c,"w").write(str(n))\n'
        'r={"id":"context-stateless","outcome":"inconclusive",'
        '"key":"contract:context-stateless:inconclusive","attempts":['
        '{"attempt":1,"outcome":"timeout","last_stage":"stage-%d"%n},'
        '{"attempt":2,"outcome":"timeout","last_stage":"stage-%d"%(n+1)}]}\n'
        'iss=[{"severity":"error","where":"bin/x","message":"first-only"}] if n==1 else []\n'
        'print(json.dumps({"errors":len(iss),"warnings":0,"inconclusive":1,'
        '"issues":iss,"contract_results":[r]}))\n'
    )
    INVALID = '#!/usr/bin/env python3\nprint("not json")\n'
    FAKE_QUEUE = (  # every queued flaw becomes actionable for dispatch-order testing
        '#!/usr/bin/env python3\n'
        'import os, sys, json\n'
        'log = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".adds")\n'
        'if len(sys.argv) > 1 and sys.argv[1] == "add":\n'
        '    open(log, "a").write(" ".join(sys.argv[2:]) + "\\n")\n'
        'elif len(sys.argv) > 1 and sys.argv[1] == "status":\n'
        '    print(json.dumps({"actionable": 1 if os.path.isfile(log) else 0}))\n'
    )
    FAKE_MEM = '#!/usr/bin/env python3\nimport json\nprint(json.dumps({"issues":[]}))\n'
    FAKE_RUNNER = (
        '#!/usr/bin/env python3\nimport os\n'
        'p=os.path.join(os.path.dirname(os.path.abspath(__file__)), ".runs")\n'
        'open(p, "a").write("run\\n")\n'
    )

    def scenario(hv_src):
        d = tempfile.mkdtemp(prefix="hv-lt-")
        try:
            bind = os.path.join(d, "bin")
            os.makedirs(bind)
            shutil.copy(lt, os.path.join(bind, "loop-tick"))
            for name, src in (("harness-verify", hv_src), ("loop-queue", FAKE_QUEUE),
                              ("mem-audit", FAKE_MEM), ("harness-agent-run", FAKE_RUNNER)):
                p = os.path.join(bind, name)
                with open(p, "w") as fh:
                    fh.write(src)
                os.chmod(p, 0o755)
            results = os.path.join(d, "results")
            genv = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t",
                        GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t",
                        HARNESS_RESULTS_DIR=results)
            # This test drives the real WATCH path, so it must opt out of the
            # harness-child marker main() sets — otherwise the tick under test
            # correctly no-ops and every assertion below fails for the wrong reason.
            genv.pop("ORCHESTRATORMAXXING_HARNESS_CHILD", None)
            subprocess.run(["git", "-C", d, "init"], capture_output=True, env=genv, timeout=30)
            proc = subprocess.run([sys.executable, os.path.join(bind, "loop-tick"), "--quiet"],
                                  capture_output=True, text=True, env=genv, cwd=d, timeout=90)
            adds = os.path.join(bind, ".adds")
            runs = os.path.join(bind, ".runs")
            observations = os.path.join(results, "harness-observations.jsonl")
            return ((open(adds).read() if os.path.isfile(adds) else ""),
                    (open(observations).read() if os.path.isfile(observations) else ""),
                    proc.returncode,
                    (open(runs).read() if os.path.isfile(runs) else ""))
        finally:
            shutil.rmtree(d, ignore_errors=True)

    try:
        flap_adds, _, flap_rc, flap_runs = scenario(FLAP)
        if "harness-verify" in flap_adds:
            fails.append("transient harness-verify red was enqueued "
                         "(persistence gate broken — would manufacture a dry round)")
        if flap_rc != 0 or flap_runs:
            fails.append("transient harness-verify red did not remain an idle success "
                         f"(rc={flap_rc}, runner_calls={len(flap_runs.splitlines())})")
        persist_adds, _, persist_rc, persist_runs = scenario(PERSIST)
        if len(persist_adds.splitlines()) != 1 or "--layer V" not in persist_adds:
            fails.append("persistent harness-verify red was NOT enqueued "
                         "(real flaws must still reach the queue)")
        if persist_rc != 2 or persist_runs:
            fails.append("persistent harness-verify red did not halt before runner dispatch")
        recovered_adds, recovered_obs, _, _ = scenario(RECOVERED)
        if "harness-verify" in recovered_adds:
            fails.append("recovered contract timeout was enqueued instead of retained as evidence")
        if '"outcome": "recovered"' not in recovered_obs or "missing-auth-offline" not in recovered_obs:
            fails.append("recovered timeout did not retain both-attempt stage evidence")
        inconclusive_adds, inconclusive_obs, _, _ = scenario(INCONCLUSIVE)
        if len(inconclusive_adds.splitlines()) != 1 or "--layer O" not in inconclusive_adds:
            fails.append("two targeted timeouts did not enqueue exactly one O-layer flaw")
        if "missing-auth-offline" in inconclusive_adds or "minimal-path-provider" in inconclusive_adds:
            fails.append("volatile stage evidence leaked into the deduplication payload")
        if '"outcome": "inconclusive"' not in inconclusive_obs or "minimal-path-provider" not in inconclusive_obs:
            fails.append("inconclusive timeout did not retain bounded stage evidence")
        mixed_adds, mixed_obs, _, _ = scenario(MIXED)
        if len(mixed_adds.splitlines()) != 1 or "--layer O" not in mixed_adds or "--layer V" in mixed_adds:
            fails.append("first-only target red plus changing observation details was mislabeled/double-enqueued")
        if "stage-1" not in mixed_obs or "stage-3" not in mixed_obs:
            fails.append("both verifier passes did not retain their changing diagnostic evidence")
        invalid_adds, invalid_obs, invalid_rc, invalid_runs = scenario(INVALID)
        if len(invalid_adds.splitlines()) != 1 or "--layer O" not in invalid_adds:
            fails.append("twice-unreadable verifier did not enqueue exactly one O-layer observer flaw")
        if "observer:harness-verify:unparseable-twice" not in invalid_obs:
            fails.append("twice-unreadable verifier did not retain observer-health evidence")
        if invalid_rc != 2 or invalid_runs:
            fails.append("twice-unreadable verifier did not halt before runner dispatch")
    except Exception as ex:
        fails.append(f"loop-tick persistence self-test crashed: {ex}")
    return fails


def loop_tick_backpressure_ok(root):
    """Black-box: research intake must hard-cap open research leads (lq-00e46b74).

    Intake can add up to 5 leads/tick while rounds drain ~1/day — without a ceiling the
    forward queue grows without bound, pins the fire-gate at permanent ACT, and drowns real
    watcher signal in unread leads (39 off-domain papers by 2026-07-17). Contract: with
    RESEARCH_OPEN_CAP open research rows already in knowledge/loop-queue.jsonl,
    `loop-tick --intake` must skip the fetch entirely (stub harness-scan never invoked) and
    enqueue nothing. Also pins harness-scan's LLM-anchor query group so a rewrite can't
    silently revert to the pre-anchor flood query. Deterministic, isolated, self-cleaning.
    """
    lt = os.path.join(root, "bin", "loop-tick")
    hs = os.path.join(root, "bin", "harness-scan")
    if not os.path.isfile(lt):
        return []  # absence handled by the Execution/Tool layer
    fails = []

    m = re.search(r"^RESEARCH_OPEN_CAP\s*=\s*(\d+)", open(lt).read(), re.M)
    if not m:
        return ["RESEARCH_OPEN_CAP missing from loop-tick (intake backpressure reverted?)"]
    cap = int(m.group(1))

    if os.path.isfile(hs) and 'foundation model' not in open(hs).read():
        fails.append("harness-scan ARXIV_QUERY lost its LLM-anchor group "
                     "(reverts to the off-domain flood query)")

    FAKE_HV = ('#!/usr/bin/env python3\nimport json\n'
               'print(json.dumps({"errors":0,"warnings":0,"issues":[]}))\n')
    FAKE_MEM = '#!/usr/bin/env python3\nimport json\nprint(json.dumps({"issues":[]}))\n'
    FAKE_QUEUE = (  # record `add` calls; answer `status --json` so the tick completes
        '#!/usr/bin/env python3\n'
        'import os, sys, json\n'
        'log = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".adds")\n'
        'if len(sys.argv) > 1 and sys.argv[1] == "add":\n'
        '    open(log, "a").write(" ".join(sys.argv[2:]) + "\\n")\n'
        'elif len(sys.argv) > 1 and sys.argv[1] == "status":\n'
        '    print(json.dumps({"actionable": 0}))\n')
    FAKE_SCAN = (  # marker file proves the fetch happened; offers one enqueue-able paper
        '#!/usr/bin/env python3\n'
        'import json, os\n'
        'open(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".scan-hit"), "w").close()\n'
        'print(json.dumps({"matched": [{"date": "2026-01-01", "title": "Stub", '
        '"link": "http://s/1", "pillars": ["orchestration"]}], "uncategorized": []}))\n')

    d = tempfile.mkdtemp(prefix="hv-bp-")
    try:
        bind = os.path.join(d, "bin")
        os.makedirs(bind)
        os.makedirs(os.path.join(d, "knowledge"))
        shutil.copy(lt, os.path.join(bind, "loop-tick"))
        for name, src in (("harness-verify", FAKE_HV), ("mem-audit", FAKE_MEM),
                          ("loop-queue", FAKE_QUEUE), ("harness-scan", FAKE_SCAN)):
            p = os.path.join(bind, name)
            with open(p, "w") as fh:
                fh.write(src)
            os.chmod(p, 0o755)
        with open(os.path.join(d, "knowledge", "loop-queue.jsonl"), "w") as fh:
            for i in range(cap):
                fh.write(json.dumps({"id": "lq-seed%d" % i, "status": "open",
                                     "source": "research", "flaw": "seed %d" % i}) + "\n")
        genv = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t",
                    GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
        genv.pop("ORCHESTRATORMAXXING_HARNESS_CHILD", None)   # drives the real watch path
        subprocess.run(["git", "-C", d, "init"], capture_output=True, env=genv, timeout=30)
        subprocess.run([sys.executable, os.path.join(bind, "loop-tick"), "--intake", "--gate", "--quiet"],
                       capture_output=True, text=True, env=genv, cwd=d, timeout=90)
        adds_p = os.path.join(bind, ".adds")
        adds = open(adds_p).read() if os.path.isfile(adds_p) else ""
        if "research lead" in adds:
            fails.append("intake enqueued research leads past the cap (%d) — backpressure broken" % cap)
        if os.path.isfile(os.path.join(bind, ".scan-hit")):
            fails.append("intake invoked harness-scan under backpressure (fetch not skipped)")
    except Exception as ex:
        fails.append(f"loop-tick backpressure self-test crashed: {ex}")
    finally:
        shutil.rmtree(d, ignore_errors=True)
    return fails


def loop_tick_ttl_wired_ok(root):
    """The TTL sweep must be WIRED INTO intake, not merely available (lq-8962bc1c).

    The flaw this guards is a deadlock, and the deadlock is silent: with only the inflow cap,
    untriaged leads accumulate until `slots = cap - open` pins at 0 and `loop-tick` stops
    fetching external research forever — harness-verify stayed green through three weeks of it.
    `loop_queue_ttl_ok` proves the sweep is correct; this proves intake actually calls it.

    End-to-end against the REAL loop-queue (only harness-verify/mem-audit/harness-scan are
    stubbed) with a queue seeded past the cap with leads far older than the TTL: intake must
    drain them and then reach the fetch. Isolated in a throwaway git repo; no network (the
    harness-scan stub answers). Empty list = pass.
    """
    lt = os.path.join(root, "bin", "loop-tick")
    lq = os.path.join(root, "bin", "loop-queue")
    if not (os.path.isfile(lt) and os.path.isfile(lq)):
        return []  # absence handled by the Execution/Tool layer
    m = re.search(r"^RESEARCH_OPEN_CAP\s*=\s*(\d+)", open(lt).read(), re.M)
    cap = int(m.group(1)) if m else 10
    fails = []
    FAKE_HV = ('#!/usr/bin/env python3\nimport json\n'
               'print(json.dumps({"errors":0,"warnings":0,"issues":[]}))\n')
    FAKE_MEM = '#!/usr/bin/env python3\nimport json\nprint(json.dumps({"issues":[]}))\n'
    FAKE_SCAN = ('#!/usr/bin/env python3\n'
                 'import json, os\n'
                 'open(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".scan-hit"), "w").close()\n'
                 'print(json.dumps({"matched": [{"date": "2026-01-01", "title": "Stub", '
                 '"link": "http://s/1", "pillars": ["orchestration"]}], "uncategorized": []}))\n')
    d = tempfile.mkdtemp(prefix="hv-ttlwire-")
    try:
        bind = os.path.join(d, "bin")
        os.makedirs(bind)
        os.makedirs(os.path.join(d, "knowledge"))
        shutil.copy(lt, os.path.join(bind, "loop-tick"))
        shutil.copy(lq, os.path.join(bind, "loop-queue"))
        os.chmod(os.path.join(bind, "loop-queue"), 0o755)
        for name, src in (("harness-verify", FAKE_HV), ("mem-audit", FAKE_MEM),
                          ("harness-scan", FAKE_SCAN)):
            p = os.path.join(bind, name)
            with open(p, "w") as fh:
                fh.write(src)
            os.chmod(p, 0o755)
        qf = os.path.join(d, "knowledge", "loop-queue.jsonl")
        with open(qf, "w") as fh:
            for i in range(cap + 2):  # seeded PAST the cap → intake is deadlocked without a sweep
                fh.write(json.dumps({"id": "lq-stale%d" % i, "ts": "2020-01-01T00:00:00Z",
                                     "layer": "G", "source": "research", "status": "open",
                                     "flaw": "stale seed %d" % i, "round": None}) + "\n")
        genv = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t",
                    GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
        genv.pop("LOOP_QUEUE_DIR", None)
        genv.pop("LOOP_QUEUE_TS", None)
        genv.pop("ORCHESTRATORMAXXING_HARNESS_CHILD", None)   # drives the real watch path
        subprocess.run(["git", "-C", d, "init"], capture_output=True, env=genv, timeout=30)
        subprocess.run([sys.executable, os.path.join(bind, "loop-tick"),
                        "--intake", "--gate", "--quiet"],
                       capture_output=True, text=True, env=genv, cwd=d, timeout=90)
        rows = [json.loads(l) for l in open(qf) if l.strip()]
        stale_open = [r for r in rows
                      if str(r.get("id", "")).startswith("lq-stale") and r.get("status") == "open"]
        if stale_open:
            fails.append("intake did not run the TTL sweep — %d stale lead(s) still open "
                         "(research intake stays deadlocked at the cap)" % len(stale_open))
        if not os.path.isfile(os.path.join(bind, ".scan-hit")):
            fails.append("intake never reached the fetch after the sweep (backpressure still pinned)")
    except Exception as ex:
        fails.append(f"loop-tick TTL-wiring self-test crashed: {ex}")
    finally:
        shutil.rmtree(d, ignore_errors=True)
    return fails


def tmux_send_transport_ok(root):
    """Static: tmux-send must address a pane and submit with C-m (lq-7e73217d).

    Found by usage 2026-07-18, not by a test: tmux-send built TARGET="=$SESSION" — a
    *session* target — and handed it to pane-scoped commands. `has-session` accepts that,
    but `send-keys`/`capture-pane` do not resolve it ("can't find pane: =name"), and every
    capture was wrapped in `2>/dev/null || echo ""`, so the failure degraded to an empty
    snapshot: the send went nowhere while the retry loop compared empty strings. A mocked
    caller never caught it because the fake sender always succeeded — the real tmux path was
    never exercised against a live pane.

    Second live finding: tmux's `Enter` alias is NOT accepted as submit by the Codex TUI —
    it inserts a newline into the composer. Only C-m submits.

    This is a static assertion on purpose. A behavioral contract would need a live tmux
    server plus a real TUI to be meaningful, and a mocked one would reproduce exactly the
    blind spot that let this ship.
    """
    ts = os.path.join(root, "bin", "tmux-send")
    if not os.path.isfile(ts):
        return []  # absence handled by the deploy-coverage check
    fails = []
    body = open(ts).read()
    code = "\n".join(ln for ln in body.splitlines() if not ln.lstrip().startswith("#"))

    if not re.search(r"""PANE=.*pane_id""", code):
        fails.append("does not resolve a concrete pane id (#{pane_id}) before pane commands")

    for cmd in ("send-keys", "capture-pane"):
        for m in re.finditer(rf'tmux {cmd} -t "\$(\w+)"', code):
            if m.group(1) != "PANE":
                fails.append(f'{cmd} addresses "${m.group(1)}" instead of the resolved "$PANE" '
                             "— a session target does not resolve to a pane")

    if re.search(r'tmux send-keys -t "\$PANE".*\bEnter\b', code):
        fails.append("submits with tmux's `Enter` alias; the Codex TUI treats it as a newline "
                     "— use C-m")
    if 'C-m' not in code:
        fails.append("never submits with C-m — no keystroke would submit in the Codex TUI")

    return fails


def shell_tmux_targets_ok(root):
    """Static: shell adapters must use exact tmux targets of the right type.

    tmux can report success for a target that did not identify the intended object:
    bare session names prefix-match, while display-message given an exact session target
    without ':' resolves no pane and prints nothing with exit 0. Scan every shell adapter
    so return-code checks cannot silently bless either failure mode. `new-session -s` is
    deliberately outside this target check because -s takes a name, not a target.
    """
    shell_dir = os.path.join(root, "shell")
    if not os.path.isdir(shell_dir):
        return []

    findings = []
    target_commands = ("has-session", "attach-session", "switch-client", "kill-session",
                       "display-message")
    command_re = re.compile(rf"\btmux\s+({'|'.join(target_commands)})\b")

    for name in sorted(os.listdir(shell_dir)):
        if not name.endswith(".sh"):
            continue
        rel = f"shell/{name}"
        path = os.path.join(shell_dir, name)
        lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
        for lineno, line in enumerate(lines, 1):
            if line.lstrip().startswith("#"):
                continue
            for command_match in command_re.finditer(line):
                command = command_match.group(1)
                invocation = line[command_match.end():]
                target_match = re.search(r"(?:^|\s)-t\s+", invocation)
                where = f"{rel}:{lineno}"
                if not target_match:
                    findings.append((where, f"tmux {command} has no -t target"))
                    continue

                target = invocation[target_match.end():].lstrip()
                quoted = target[:1] if target[:1] in ("\"", "'") else ""
                value = target[1:] if quoted else target
                helper = re.match(r"\$\([A-Za-z_][A-Za-z0-9_]*_tmux_target\b", value)
                literal = value.startswith("=")
                if not (helper or literal):
                    findings.append((where,
                                     f"tmux {command} -t must be '='-prefixed literally "
                                     "or use a *_tmux_target helper"))
                    continue

                if command != "display-message":
                    continue
                if helper:
                    pane_target = re.match(
                        r"\$\([A-Za-z_][A-Za-z0-9_]*_tmux_target\b[^)]*\):", value)
                else:
                    end = value.find(quoted) if quoted else len(value.split(None, 1)[0])
                    pane_target = value[:end].endswith(":")
                if not pane_target:
                    findings.append((where,
                                     "tmux display-message -t must be ':'-suffixed "
                                     "to resolve a pane"))
    return findings


def codex_g_behavior_ok(root):
    """Black-box contract for the sourced `g` launcher using fake tmux/codex.

    This protects the high-risk shell boundary: exact tmux names, name
    sanitization, Codex-native -a forwarding, literal argument boundaries, and
    the headless prompt gate. It never starts Codex or touches real tmux state.
    """
    script = os.path.join(root, "shell", "codex-g.sh")
    if not os.path.isfile(script):
        return []
    tmp = tempfile.mkdtemp(prefix="hv-codex-g-")
    log = os.path.join(tmp, "tmux.jsonl")
    fake_tmux = os.path.join(tmp, "tmux")
    fake_codex = os.path.join(tmp, "codex")
    fake_substitution = os.path.join(tmp, "must-not-run")
    substitution_marker = os.path.join(tmp, "substitution-executed")
    fails = []
    try:
        with open(fake_tmux, "w") as fh:
            fh.write("""#!/usr/bin/env python3
import json, os, sys
with open(os.environ["G_TMUX_LOG"], "a") as out:
    out.write(json.dumps(sys.argv[1:]) + "\\n")
if len(sys.argv) > 1 and sys.argv[1] == "has-session":
    raise SystemExit(1)
raise SystemExit(0)
""")
        with open(fake_codex, "w") as fh:
            fh.write("#!/usr/bin/env sh\nexit 0\n")
        with open(fake_substitution, "w") as fh:
            fh.write('#!/usr/bin/env sh\nprintf executed > "$G_SUBSTITUTION_MARKER"\n')
        os.chmod(fake_tmux, 0o755)
        os.chmod(fake_codex, 0o755)
        os.chmod(fake_substitution, 0o755)
        env = dict(os.environ, PATH=tmp + os.pathsep + os.environ.get("PATH", ""),
                   G_TMUX_LOG=log, G_SUBSTITUTION_MARKER=substitution_marker,
                   SHOULD_NOT_LEAK="secret-sentinel")
        # The interactive launch contract exercises the outside-tmux branch.
        # Do not let the verifier's own tmux ancestry select a different path.
        env.pop("TMUX", None)
        literal = "literal ; $(must-not-run) * newline-safe"
        cmd = 'source "$1"; g "$2" -a never -- "$3"'
        r = subprocess.run(["bash", "-c", cmd, "bash", script, "bad name/..", literal],
                           capture_output=True, text=True, env=env, timeout=15)
        if r.returncode != 0:
            fails.append(f"interactive fake launch exited {r.returncode}: {r.stderr.strip()}")
        if os.path.exists(substitution_marker):
            fails.append("launcher executed command substitution from a literal argument")
        rows = []
        if os.path.isfile(log):
            rows = [json.loads(line) for line in open(log) if line.strip()]
        launches = [row for row in rows if row and row[0] == "new-session"]
        if len(launches) != 1:
            fails.append(f"expected one tmux new-session call, got {len(launches)}")
        else:
            argv = launches[0]
            try:
                sess = argv[argv.index("-s") + 1]
            except (ValueError, IndexError):
                sess = None
            if sess != "codex-bad-name":
                fails.append(f"name sanitization wrong (got {sess!r}, want 'codex-bad-name')")
            for token in ("--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust",
                          "-a", "never", literal):
                if token not in argv:
                    fails.append(f"forwarding lost exact argument: {token!r}")
            if any("SHOULD_NOT_LEAK" in arg or "secret-sentinel" in arg for arg in argv):
                fails.append("launcher bulk-copied unrelated environment/secrets into tmux")
        exact = subprocess.run(["bash", "-c", 'source "$1"; _g_tmux_target codex-x',
                                "bash", script], capture_output=True, text=True, env=env, timeout=10)
        if exact.stdout.strip() != "=codex-x":
            fails.append("tmux target is not exact (=codex-x)")
        gated = subprocess.run(["bash", "-c", 'source "$1"; g demo --headless',
                                "bash", script], capture_output=True, text=True, env=env, timeout=10)
        if gated.returncode != 2 or "requires --prompt" not in gated.stderr:
            fails.append("headless mode did not fail closed without --prompt")
        aliased = subprocess.run(["bash", "-c", 'shopt -s expand_aliases; alias g=false; source "$1"; type -t g',
                                  "bash", script], capture_output=True, text=True, env=env, timeout=10)
        if aliased.returncode or aliased.stdout.strip() != "function":
            fails.append("launcher did not replace a pre-existing g alias")
        remote = os.path.join(root, "bin", "harness-remote")
        if os.path.isfile(remote):   # fleet-only tool; absent from the graduated core tree
            remote_home = os.path.join(tmp, "remote-home")
            remote_work = os.path.join(remote_home, "work")
            os.makedirs(remote_work)
            remote_env = dict(env, HOME=remote_home)
            remote_check = subprocess.run([remote, "--cwd", "~/work", "check"],
                                          capture_output=True, text=True, env=remote_env, timeout=10)
            # Bash preserves the logical /var path in PWD on macOS even though
            # realpath resolves it through /private/var.
            expected_cwd = f"cwd={os.path.abspath(remote_work)}"
            if remote_check.returncode or expected_cwd not in remote_check.stdout:
                fails.append(f"remote entrypoint did not expand a quoted ~/ cwd: {remote_check.stderr.strip()}")
    except Exception as ex:
        fails.append(f"g launcher self-test crashed: {ex}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return fails


def opencode_o_behavior_ok(root):
    """Black-box contract for the sourced `o` launcher using fake tmux/opencode/occ.

    Mirrors codex_g_behavior_ok for the OpenCode sibling: exact tmux names, name
    sanitization, literal argument boundaries, the headless prompt gate, and the
    occ-hardened one-shot path (one-shots must ride occ, never bare `opencode
    run`, because opencode 1.17.x intermittently hangs at startup —
    lq-6e4c38c5). It never starts OpenCode or touches real tmux state.
    """
    script = os.path.join(root, "shell", "opencode-o.sh")
    if not os.path.isfile(script):
        return []
    tmp = tempfile.mkdtemp(prefix="hv-opencode-o-")
    log = os.path.join(tmp, "tmux.jsonl")
    occ_log = os.path.join(tmp, "occ.jsonl")
    fake_tmux = os.path.join(tmp, "tmux")
    fake_opencode = os.path.join(tmp, "opencode")
    fake_occ = os.path.join(tmp, "occ")
    fake_substitution = os.path.join(tmp, "must-not-run")
    substitution_marker = os.path.join(tmp, "substitution-executed")
    fails = []
    try:
        with open(fake_tmux, "w") as fh:
            fh.write("""#!/usr/bin/env python3
import json, os, sys
with open(os.environ["O_TMUX_LOG"], "a") as out:
    out.write(json.dumps(sys.argv[1:]) + "\\n")
if len(sys.argv) > 1 and sys.argv[1] == "has-session":
    raise SystemExit(1)
raise SystemExit(0)
""")
        with open(fake_opencode, "w") as fh:
            fh.write("#!/usr/bin/env sh\nexit 0\n")
        with open(fake_occ, "w") as fh:
            fh.write("""#!/usr/bin/env python3
import json, os, sys
with open(os.environ["O_OCC_LOG"], "a") as out:
    out.write(json.dumps(sys.argv[1:]) + "\\n")
raise SystemExit(0)
""")
        with open(fake_substitution, "w") as fh:
            fh.write('#!/usr/bin/env sh\nprintf executed > "$O_SUBSTITUTION_MARKER"\n')
        for path in (fake_tmux, fake_opencode, fake_occ, fake_substitution):
            os.chmod(path, 0o755)
        env = dict(os.environ, PATH=tmp + os.pathsep + os.environ.get("PATH", ""),
                   O_TMUX_LOG=log, O_OCC_LOG=occ_log,
                   O_SUBSTITUTION_MARKER=substitution_marker,
                   SHOULD_NOT_LEAK="secret-sentinel")
        # The interactive launch contract exercises the outside-tmux branch.
        env.pop("TMUX", None)
        literal = "literal ; $(must-not-run) * newline-safe"
        cmd = 'source "$1"; o "$2" --agent glm-coder -- "$3"'
        r = subprocess.run(["bash", "-c", cmd, "bash", script, "bad name/..", literal],
                           capture_output=True, text=True, env=env, timeout=15)
        if r.returncode != 0:
            fails.append(f"interactive fake launch exited {r.returncode}: {r.stderr.strip()}")
        if os.path.exists(substitution_marker):
            fails.append("launcher executed command substitution from a literal argument")
        rows = []
        if os.path.isfile(log):
            rows = [json.loads(line) for line in open(log) if line.strip()]
        launches = [row for row in rows if row and row[0] == "new-session"]
        if len(launches) != 1:
            fails.append(f"expected one tmux new-session call, got {len(launches)}")
        else:
            argv = launches[0]
            try:
                sess = argv[argv.index("-s") + 1]
            except (ValueError, IndexError):
                sess = None
            if sess != "opencode-bad-name":
                fails.append(f"name sanitization wrong (got {sess!r}, want 'opencode-bad-name')")
            for token in ("--agent", "glm-coder", literal):
                if token not in argv:
                    fails.append(f"forwarding lost exact argument: {token!r}")
            if any("SHOULD_NOT_LEAK" in arg or "secret-sentinel" in arg for arg in argv):
                fails.append("launcher bulk-copied unrelated environment/secrets into tmux")
        exact = subprocess.run(["bash", "-c", 'source "$1"; _o_tmux_target opencode-x',
                                "bash", script], capture_output=True, text=True, env=env, timeout=10)
        if exact.stdout.strip() != "=opencode-x":
            fails.append("tmux target is not exact (=opencode-x)")
        gated = subprocess.run(["bash", "-c", 'source "$1"; o demo --headless',
                                "bash", script], capture_output=True, text=True, env=env, timeout=10)
        if gated.returncode != 2 or "requires --prompt" not in gated.stderr:
            fails.append("headless mode did not fail closed without --prompt")
        aliased = subprocess.run(["bash", "-c", 'shopt -s expand_aliases; alias o=false; source "$1"; type -t o',
                                  "bash", script], capture_output=True, text=True, env=env, timeout=10)
        if aliased.returncode or aliased.stdout.strip() != "function":
            fails.append("launcher did not replace a pre-existing o alias")
        oneshot = subprocess.run(["bash", "-c", 'source "$1"; o --prompt "ask me" --agent kimi-coder',
                                  "bash", script], capture_output=True, text=True, env=env, timeout=10)
        if oneshot.returncode != 0:
            fails.append(f"one-shot --prompt exited {oneshot.returncode}: {oneshot.stderr.strip()}")
        occ_rows = []
        if os.path.isfile(occ_log):
            occ_rows = [json.loads(line) for line in open(occ_log) if line.strip()]
        if len(occ_rows) != 1:
            fails.append(f"one-shot did not ride occ exactly once (got {len(occ_rows)} calls)")
        elif occ_rows[0] != ["ask me", "--agent", "kimi-coder"]:
            fails.append(f"occ one-shot argv wrong: {occ_rows[0]!r}")
    except Exception as ex:
        fails.append(f"o launcher self-test crashed: {ex}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return fails


def shared_memory_behavior_ok(root):
    """Black-box shared-memory contract across resolver, writes, audit, and sync safety."""
    memoryctl = os.path.join(root, "bin", "memoryctl")
    memaudit = os.path.join(root, "bin", "mem-audit")
    sync = os.path.join(root, "bin", "harness-sync")
    if not all(os.path.isfile(p) for p in (memoryctl, memaudit, sync)):
        return ["memoryctl/mem-audit/harness-sync missing"]
    tmp = tempfile.mkdtemp(prefix="hv-shared-memory-")
    home = os.path.join(tmp, "home")
    repo = os.path.join(tmp, "repo-a")
    repo2 = os.path.join(tmp, "repo-b")
    remote = os.path.join(tmp, "origin.git")
    os.makedirs(home)
    fails = []
    env = dict(os.environ, HOME=home, XDG_DATA_HOME=os.path.join(home, ".local", "share"))

    def run(cmd, cwd=repo, stdin=None, timeout=20):
        return subprocess.run(cmd, cwd=cwd, env=env, input=stdin, capture_output=True,
                              text=True, timeout=timeout)

    def git(cwd, *args):
        return run(["git", *args], cwd=cwd)

    try:
        subprocess.run(["git", "init", "--bare", remote], capture_output=True, timeout=10)
        for path in (repo, repo2):
            os.makedirs(path)
            git(path, "init")
            git(path, "config", "user.email", "verify@example.invalid")
            git(path, "config", "user.name", "Harness Verify")
            git(path, "branch", "-M", "main")
            git(path, "remote", "add", "origin", remote)
            with open(os.path.join(path, "seed"), "w") as fh:
                fh.write("seed\n")
            git(path, "add", "seed")
            git(path, "commit", "-m", "seed")

        key1 = run([memoryctl, "key"], cwd=repo)
        key2 = run([memoryctl, "key"], cwd=repo2)
        if key1.returncode or key1.stdout.strip() != key2.stdout.strip():
            fails.append("same git remote did not resolve to the same cross-machine project key")

        init = run([memoryctl, "init"])
        shared = os.path.join(repo, ".agents", "memory")
        if init.returncode or not os.path.isfile(os.path.join(shared, "MEMORY.md")):
            fails.append("init did not create repo-local shared memory")

        add = run([memoryctl, "add", "alpha", "--description", "first fact",
                   "--type", "project", "--source", "contract", "--body", "alpha body"])
        if add.returncode or not os.path.isfile(os.path.join(shared, "alpha.md")):
            fails.append(f"add failed: {add.stderr.strip()}")
        secret = run([memoryctl, "add", "bad-secret", "--description", "credential",
                      "--source", "contract", "--body", "api_key=secretvalue123"])
        if secret.returncode == 0 or os.path.exists(os.path.join(shared, "bad-secret.md")):
            fails.append("credential-like memory was not rejected")
        injected = run([memoryctl, "add", "bad-metadata", "--description", "line one\nstatus: superseded",
                        "--source", "contract", "--body", "safe body"])
        if injected.returncode == 0 or os.path.exists(os.path.join(shared, "bad-metadata.md")):
            fails.append("multiline frontmatter injection was not rejected")
        tiny = run([memoryctl, "brief", "--max-bytes", "8"])
        if len(tiny.stdout.encode()) > 8:
            fails.append("bounded brief exceeded max-bytes")

        sup = run([memoryctl, "supersede", "alpha", "beta", "--description", "replacement fact",
                   "--type", "project", "--source", "contract", "--body", "beta body",
                   "--resolution-rule", "evidence-merge"])
        if sup.returncode:
            fails.append(f"supersede failed: {sup.stderr.strip()}")
        else:
            old = open(os.path.join(shared, "alpha.md")).read()
            idx = open(os.path.join(shared, "MEMORY.md")).read()
            if "status: superseded" not in old or "superseded_by: beta" not in old:
                fails.append("supersede did not preserve/link the losing fact")
            if "alpha.md" in idx or "beta.md" not in idx:
                fails.append("supersede did not rebuild the active index")

        # Reverification is intentionally narrower than supersession: it may
        # refresh one active fact's evidence date and nothing else. Seed an old
        # date so this contract remains meaningful on every calendar day.
        beta_path = os.path.join(shared, "beta.md")
        index_path = os.path.join(shared, "MEMORY.md")
        beta_before = open(beta_path).read()
        beta_before = re.sub(
            r"(?m)^(\s*last_verified:\s*)\d{4}-\d{2}-\d{2}$",
            r"\g<1>2000-01-01", beta_before, count=1)
        with open(beta_path, "w") as fh:
            fh.write(beta_before)
        index_before = open(index_path).read()
        reverified = run([memoryctl, "reverify", "beta"])
        beta_after = open(beta_path).read()
        expected_beta = beta_before.replace(
            "  last_verified: 2000-01-01",
            f"  last_verified: {time.strftime('%Y-%m-%d', time.gmtime())}", 1)
        if reverified.returncode or beta_after != expected_beta:
            fails.append(
                "reverify did not change exactly the active fact's last_verified line: "
                f"{reverified.stderr.strip()}")
        if open(index_path).read() != index_before:
            fails.append("reverify rewrote MEMORY.md even though no indexed field changed")

        before_refusals = {
            name: open(os.path.join(shared, name)).read()
            for name in ("alpha.md", "beta.md", "MEMORY.md")
        }
        missing_reverify = run([memoryctl, "reverify", "missing"])
        superseded_reverify = run([memoryctl, "reverify", "alpha"])
        after_refusals = {
            name: open(os.path.join(shared, name)).read()
            for name in before_refusals
        }
        if missing_reverify.returncode == 0 or superseded_reverify.returncode == 0:
            fails.append("reverify accepted a missing or superseded memory")
        if after_refusals != before_refusals:
            fails.append("a refused reverify mutated the memory store")

        # Local-lock concurrency: both independent facts must survive.
        base = [memoryctl, "add"]
        p1 = subprocess.Popen(base + ["concurrent-a", "--description", "a", "--source", "contract", "--body", "a"], cwd=repo, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        p2 = subprocess.Popen(base + ["concurrent-b", "--description", "b", "--source", "contract", "--body", "b"], cwd=repo, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        p1.communicate(timeout=20); p2.communicate(timeout=20)
        if p1.returncode or p2.returncode or not all(os.path.isfile(os.path.join(shared, f"concurrent-{x}.md")) for x in ("a", "b")):
            fails.append("concurrent locked adds did not both survive")

        # Match memoryctl's Path.resolve() behavior. This matters on macOS, where
        # tempfile returns /var/... but the canonical path is /private/var/....
        legacy_slug = os.path.realpath(repo).replace("/", "-")
        legacy = os.path.join(home, ".claude", "projects", legacy_slug, "memory")
        os.makedirs(legacy, exist_ok=True)
        legacy_text = (open(os.path.join(shared, "beta.md")).read()
                       .replace("name: beta", "name: legacy", 1)
                       .replace("description: replacement fact", "description: imported fact", 1)
                       .replace("  supersedes: alpha\n", "", 1)
                       .replace("metadata:\n", "metadata: \n", 1))
        with open(os.path.join(legacy, "legacy.md"), "w") as fh:
            fh.write(legacy_text)
        dry = run([memoryctl, "import-claude"])
        if dry.returncode or os.path.exists(os.path.join(shared, "legacy.md")):
            fails.append("legacy import was not dry-run by default")
        apply = run([memoryctl, "import-claude", "--apply"])
        again = run([memoryctl, "import-claude", "--apply"])
        if apply.returncode or again.returncode or not os.path.isfile(os.path.join(shared, "legacy.md")):
            fails.append("legacy import was not apply/idempotent")
        elif "metadata: \n" in open(os.path.join(shared, "legacy.md")).read():
            fails.append("legacy import did not normalize empty metadata trailing whitespace")
        bridge = run([memoryctl, "bridge-claude", "--apply"])
        if bridge.returncode or not os.path.islink(legacy) or os.path.realpath(legacy) != os.path.realpath(shared):
            fails.append(f"Claude compatibility bridge failed: {bridge.stderr.strip()}")

        audited = run([memaudit, "--dir", shared, "--json"])
        try:
            report = json.loads(audited.stdout)
            if audited.returncode or any(x.get("severity") == "error" for x in report.get("issues", [])):
                fails.append("mem-audit did not accept the governed shared store")
        except ValueError:
            fails.append("mem-audit shared-store JSON was invalid")

        # Cross-machine pull must fail closed on dirty state.
        git(repo, "add", ".")
        git(repo, "commit", "-m", "memory")
        git(repo, "push", "-u", "origin", "HEAD:main")
        subprocess.run(["git", "--git-dir", remote, "symbolic-ref", "HEAD", "refs/heads/main"],
                       capture_output=True, timeout=10)
        with open(os.path.join(repo, "dirty"), "w") as fh:
            fh.write("dirty\n")
        refused = run([sync, "pull"])
        if refused.returncode == 0 or "dirty" not in refused.stderr.lower():
            fails.append("harness-sync pull did not refuse a dirty tree")
        os.unlink(os.path.join(repo, "dirty"))

        # A clean behind-only checkout must advance by fast-forward.
        upstream = os.path.join(tmp, "upstream-writer")
        cloned = subprocess.run(["git", "clone", remote, upstream], capture_output=True, text=True, timeout=20)
        if cloned.returncode:
            fails.append("could not create fast-forward contract fixture")
        else:
            git(upstream, "config", "user.email", "verify@example.invalid")
            git(upstream, "config", "user.name", "Harness Verify")
            with open(os.path.join(upstream, "upstream"), "w") as fh:
                fh.write("new\n")
            git(upstream, "add", "upstream")
            git(upstream, "commit", "-m", "upstream")
            pushed = git(upstream, "push", "origin", "main")
            pulled = run([sync, "pull"])
            if pushed.returncode or pulled.returncode or not os.path.isfile(os.path.join(repo, "upstream")):
                fails.append(f"harness-sync did not perform a clean fast-forward: {pulled.stderr.strip()}")
    except Exception as ex:
        fails.append(f"shared-memory self-test crashed: {ex}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return fails


# Sentinels that must survive inside the deployed doctrine block. Byte-identical
# comparison is impossible on purpose: install.sh injects a Codex-only routing line,
# so the three deployed blocks legitimately differ. These phrases are the load-bearing
# content — their absence means the block was truncated or overwritten.
DOCTRINE_BEGIN = "<!-- orchestratormaxxing:orchestrator:begin -->"
DOCTRINE_END = "<!-- orchestratormaxxing:orchestrator:end -->"
DOCTRINE_SENTINELS = (
    "Frontier orchestrator workers",
    "Iron rule of verification",
    "Memory governance:",
    "Compact Instructions",
)

# Deliberate third-party hook tools the maintainer runs. Repo-owned tools are derived
# from bin/ at runtime, and commands pointing inside the repo are recognized separately,
# so this list never needs updating when the harness ships another hook tool.
KNOWN_HOOK_OWNERS = ()


def _hook_command_is_owned(command, root, shipped_tools):
    """Return whether a global hook belongs to this repo or an approved third party."""
    root = os.path.abspath(root).rstrip(os.sep)
    if root and re.search(rf"(?<![\w./-]){re.escape(root)}(?=$|/|[\s\"'`;&|()])", command):
        return True

    # A slash is a valid boundary before a basename, but word/dot/hyphen characters
    # are not. In particular, the short shipped tool `oll` must not match `collect`.
    for name in (*shipped_tools, *KNOWN_HOOK_OWNERS):
        if name and re.search(
            rf"(?:(?<![\w./-])|(?<=/)){re.escape(name)}(?![\w-])", command
        ):
            return True
    return False

# Registered plugin marketplaces we expect on a deployed machine. On 2026-07-26 a
# foreign marketplace ("engram", from a third-party installer) was removed by deleting
# ~/.claude/plugins/marketplaces/engram — and Claude Code RE-CLONED it 23 minutes later
# from git, because ~/.claude/plugins/known_marketplaces.json and
# ~/.claude/plugins/installed_plugins.json still listed it. The registries are the
# authority; the directory is only a view — deleting the view doesn't deregister it.
# "i-have-adhd" (https://github.com/ayghri/i-have-adhd) is DELIBERATE, not foreign: it backs
# the output style both CLAUDE.md and AGENTS.md mandate as permanently active, its Claude
# install cache is present and enabled, and its Codex marketplace is git-sourced and was
# refreshed 2026-08-10. Allowlisted explicitly, with the source recorded, rather than left to
# emit 5 permanent warnings — a gate that is never green is a gate nobody reads. Note the
# KNOWN fragility this does NOT paper over: the *Claude-side* marketplace still points at
# `directory: /tmp/i-have-adhd`, which no longer exists, so the plugin survives only via its
# cache and cannot be re-resolved if that cache is cleared. Re-add it from the git source to
# fix that; allowlisting only silences the "is this foreign?" question, which is answered.
KNOWN_PLUGIN_MARKETPLACES = ("claude-code-warp", "claude-hud", "claude-plugins-official",
                             "openai-codex", "i-have-adhd")
# "openai-curated" is Codex's builtin curated marketplace — implicit today (absent from
# config.toml), but any Codex version that materializes it must not warn on stock state.
KNOWN_CODEX_MARKETPLACES = ("openai-curated", "personal", "i-have-adhd")

# (name, source) pinning — lq-d45051fa. Name-only matching let a foreign installer pass
# green by REUSING a known name; on the Codex side [marketplaces.personal] would also
# clobber our own registration. Identities are "<kind>:<repo|url|path>", MEASURED from a
# deployed machine, never guessed: a guessed pin warns forever on the machine that
# legitimately registers it (provenance-before-trust). That is why claude-code-warp is
# absent — its deployed source has not been measured; pin it when it is. A known name
# missing from this table stays name-only matched.
KNOWN_PLUGIN_MARKETPLACE_SOURCES = {
    "claude-plugins-official": ("github:anthropics/claude-plugins-official",),
    "openai-codex": ("github:openai/codex-plugin-cc",),
    "claude-hud": ("github:jarrodwatts/claude-hud",),
    # Claude-side install on the Linux server is directory-sourced (the /tmp fragility
    # documented above); a git re-add from the ayghri repo is equally legitimate.
    "i-have-adhd": ("directory:/tmp/i-have-adhd",
                    "git:https://github.com/ayghri/i-have-adhd.git",
                    "github:ayghri/i-have-adhd"),
}
KNOWN_CODEX_MARKETPLACE_SOURCES = {
    "i-have-adhd": ("git:https://github.com/ayghri/i-have-adhd.git",),
    # "personal" is deliberately NOT pinned to a literal path: the checkout lives at
    # ~/dev on Ubuntu, ~/Dev on the Mac, and harness-verify itself runs from loop
    # worktrees — a realpath pin would manufacture phantom warns (signal-vs-artifact).
    # Its identity is CONTENT: the source must be a checkout of this harness, verified by
    # _is_orchestratormaxxing_checkout below.
}


def _claude_marketplace_identity(entry):
    """Canonical "<kind>:<value>" for a Claude-side marketplace registration, or None.

    Both known_marketplaces.json entries and settings.json extraKnownMarketplaces carry
    the same {"source": {"source": kind, "repo"|"url"|"path": value}} shape.
    """
    src = (entry or {}).get("source") if isinstance(entry, dict) else None
    if not isinstance(src, dict):
        return None
    kind = src.get("source")
    value = src.get("repo") or src.get("url") or src.get("path")
    if not kind or not value:
        return None
    return f"{kind}:{value}"


def _codex_marketplace_identity(entry):
    """Canonical "<source_type>:<source>" for a Codex [marketplaces.*] table, or None."""
    if not isinstance(entry, dict):
        return None
    kind, value = entry.get("source_type"), entry.get("source")
    if not kind or not value:
        return None
    return f"{kind}:{value}"


def _is_orchestratormaxxing_checkout(path):
    """True iff `path` is a checkout of this harness: its .agents/plugins/marketplace.json
    declares the orchestratormaxxing plugin. Content identity, not a path compare, so the check
    holds across machines and worktrees. Unreadable/absent/foreign all return False —
    a clobbered registration must never read as genuine because the payload was odd."""
    if not isinstance(path, str) or not path:
        return False
    try:
        with open(os.path.join(path, ".agents", "plugins", "marketplace.json"),
                  encoding="utf-8") as fh:
            manifest = json.load(fh)
    except Exception:
        return False
    plugins = manifest.get("plugins") if isinstance(manifest, dict) else None
    return any(isinstance(p, dict) and p.get("name") == "orchestratormaxxing"
               for p in (plugins if isinstance(plugins, list) else []))


def retired_bin_names(root):
    """Bridge names this repo once shipped in bin/ and no longer ships.

    Returns (names, measured). Derived from git history rather than a manifest file,
    because a manifest is one more thing install.sh has to remember to update — and the
    flaw this feeds (lq-68ae90d6) is precisely install.sh forgetting.

    `--no-renames` is load-bearing (critic, 2026-08-14, measured): with git's default
    rename detection a `git mv bin/foo bin/bar` is reported as R and `--diff-filter=D`
    prints NOTHING, so the stranded ~/.local/bin/foo stays invisible — the flaw again,
    one level down. Forcing delete+add reporting makes the OLD name retired, which is
    exactly the name left on PATH.

    `measured` is False when git cannot be read. An unreadable history is "no signal",
    NOT "nothing retired" — the caller must report the difference rather than let a
    failed measurement render as a clean result (knowledge/signal-vs-artifact-2026-07-19).

    A SHALLOW clone is the sharp edge of that rule and is refused explicitly (critic,
    2026-08-14): `git log` there exits 0 with empty output, so "history truncated" and
    "nothing was ever deleted" are byte-identical — the failed measurement would render
    as a clean machine, which is the exact failure this function claims to prevent.

    Scope note: the set is every top-level path ever deleted under bin/, not only files
    install.sh once deployed — history does not record which were bridges. A non-tool
    name can therefore enter the set, but it can only be REPORTED if that same name is
    also sitting in $BIN_DST, which is the condition we care about anyway.
    """
    # One failure path for both queries, on purpose: two copies of "git blew up -> no
    # signal" is two branches a contract has to reach separately, and the second copy is
    # the one that stays untested (mutation gate, 2026-08-14).
    def _git(*args):
        try:
            out = subprocess.run(["git", "-C", root, *args],
                                 capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.SubprocessError):
            return None          # git absent or unrunnable
        return out if out.returncode == 0 else None

    shallow = _git("rev-parse", "--is-shallow-repository")
    if shallow is None or shallow.stdout.strip() != "false":
        return set(), False
    out = _git("log", "--no-renames", "--diff-filter=D", "--name-only", "--format=",
               "--", "bin/")
    if out is None:
        return set(), False
    names = set()
    for line in out.stdout.splitlines():
        rel = line.strip()
        if not rel.startswith("bin/"):
            continue
        name = rel[len("bin/"):]
        # Only top-level bridges are copied to $BIN_DST; bin/sub/dir files are not.
        if name and "/" not in name:
            names.add(name)
    return names, True


def tailnet_mcp_posture_ok(root, home=None, status_json=None):
    """The Hermes MCP must never be reachable from the public internet.

    `status_json` and `home` are injectable so tests/tailnet-mcp-posture can drive
    this against frozen fixtures instead of the maintainer's live tailnet.

    Measured live on 2026-08-16, and the reason this exists: `tailscale funnel` —
    which is the PUBLIC internet, not the tailnet — was on at :443 with
    `/mcp -> 127.0.0.1:5556`, putting the orchestrator's 172-tool MCP surface on
    the open web. It was Bearer-gated, so it was an unnecessary attack surface
    rather than an open door, but nothing in the harness would ever have said so:
    `orchestrator/mcp_sse_server.py` CONTRADICTED ITSELF about its own posture
    (docstring: "exposed to the tailnet ... never a raw public bind"; comment 50
    lines below: "exposed to the internet via tailscale funnel"), and prose that
    disagrees with itself cannot be a control. Ricardo's decision that day was
    tailnet/loopback only. This turns that decision into a gate.

    Two shapes are errors, both observed in the live config that day:
      1. a funnel-enabled hostport whose handlers proxy to the MCP port
      2. a funnel grant with NO serve config at all (the orphan :8443 shape) —
         drift that grants public reach to whatever is configured there next

    Skips silently when tailscale is absent or the MCP unit is not installed: a
    fresh clone must stay green, and "couldn't measure" is never reported as
    "failed" (knowledge/signal-vs-artifact-2026-07-19.md).
    """
    issues = []
    home = home or os.path.expanduser("~")

    if status_json is None:
        if not shutil.which("tailscale"):
            return issues
        if not os.path.isfile(os.path.join(
                home, ".config", "systemd", "user", "hermes-mcp-sse.service")):
            return issues
        try:
            out = subprocess.run(["tailscale", "serve", "status", "-json"],
                                 capture_output=True, text=True, timeout=20)
        except (OSError, subprocess.SubprocessError) as ex:
            issues.append(("warn", "tailscale", f"could not read serve status: {ex}"))
            return issues
        if out.returncode != 0:
            issues.append(("warn", "tailscale",
                           f"serve status exited {out.returncode} — posture unverified"))
            return issues
        raw = (out.stdout or "").strip()
        if not raw or raw == "null":
            return issues  # no serve config at all: nothing is exposed
        try:
            status_json = json.loads(raw)
        except ValueError as ex:
            issues.append(("warn", "tailscale", f"unparseable serve status: {ex}"))
            return issues

    if not isinstance(status_json, dict):
        return issues
    funnels = status_json.get("AllowFunnel") or {}
    web = status_json.get("Web") or {}
    mcp_port = os.environ.get("HERMES_MCP_SSE_PORT", "5556")

    for hostport, enabled in sorted(funnels.items()):
        if not enabled:
            continue
        handlers = ((web.get(hostport) or {}).get("Handlers") or {})
        if not handlers:
            issues.append(("error", "tailscale funnel",
                           f"{hostport}: funnel granted with no serve config — an orphan "
                           f"public grant; whatever is configured there next is public "
                           f"(run: tailscale funnel --https={hostport.rsplit(':', 1)[-1]} off)"))
            continue
        for path, handler in sorted(handlers.items()):
            proxy = str((handler or {}).get("Proxy") or "")
            if f":{mcp_port}" in proxy:
                issues.append(("error", "tailscale funnel",
                               f"{hostport}{path} -> {proxy}: the Hermes MCP is exposed to "
                               f"the PUBLIC internet. Doctrine is tailnet/loopback only "
                               f"(run: tailscale funnel --https="
                               f"{hostport.rsplit(':', 1)[-1]} off)"))
    return issues


def deployed_host_state_ok(root, home=None):
    """Verify the artifacts that actually run, not just the repo source of truth.

    `home` is injectable so tests/deployed-host-state can exercise this against a fixture
    tree instead of mutating the maintainer's real ~/.claude and ~/.codex.

    A guard that inspects only the repo copy of a *global* setting is a measurement
    artifact of exactly the kind knowledge/signal-vs-artifact-2026-07-19.md warns about:
    on 2026-07-24 a third-party installer wrote a compaction override into
    ~/.codex/config.toml and widened agents.max_depth to 2, and this gate reported green
    because it only ever read <repo>/.codex/config.toml. It also deleted the deployed
    orchestratormaxxing doctrine block from ~/.codex/AGENTS.md, unnoticed for 2h40m.

    Skips entirely when the harness is not installed on this machine, so a fresh clone
    or CI checkout stays green. Absent individual files are skipped, never failed.
    """
    issues = []
    home = home or os.path.expanduser("~")

    # Install marker: install.sh writes the shell helpers here. No marker -> not deployed.
    if not os.path.isdir(os.path.join(home, ".config", "orchestratormaxxing")):
        return issues

    # --- P1: deployed host configs carry no compaction pin and no widened fan-out ---
    codex_cfg = os.path.join(home, ".codex", "config.toml")
    if os.path.isfile(codex_cfg):
        try:
            with open(codex_cfg, "rb") as fh:
                cfg = tomllib.load(fh)
        except Exception as ex:
            issues.append(("warn", "~/.codex/config.toml", f"unparseable TOML: {ex}"))
        else:
            # Scan nested tables too. A pin only takes effect at top level, but scanning
            # the whole tree removes an ambiguity class: a red-proof that appended the key
            # at EOF landed it inside [mcp_servers] and read as "not caught", which is
            # indistinguishable from a broken check without this.
            def _pins(node, keys, path=""):
                found = []
                if isinstance(node, dict):
                    for k, v in node.items():
                        if k in keys:
                            found.append(f"{path}{k}")
                        found.extend(_pins(v, keys, f"{path}{k}."))
                return found

            for pin in _pins(cfg, set(COMPACTION_OVERRIDE_KEYS["codex"])):
                issues.append(("error", "~/.codex/config.toml",
                               compaction_override_msg("codex", pin.split(".")[-1])
                               + (f" (at {pin})" if "." in pin else "")))
            depth = (cfg.get("agents") or {}).get("max_depth")
            if depth is not None and depth != 1:
                issues.append(("warn", "~/.codex/config.toml",
                               f"agents.max_depth={depth} in the DEPLOYED config while the repo "
                               f"pins 1 — something widened recursive fan-out globally"))

            # Registry entry is pre-positioning, not execution — warn, not error (hooks
            # are the execution surface P3 covers, and a legit new marketplace must not
            # red the daily loop).
            codex_markets = cfg.get("marketplaces")
            if codex_markets is not None and not isinstance(codex_markets, dict):
                issues.append(("warn", "~/.codex/config.toml",
                               f"unexpected [marketplaces] type {type(codex_markets).__name__}"))
            else:
                for name, entry in (codex_markets or {}).items():
                    if name not in KNOWN_CODEX_MARKETPLACES:
                        issues.append(("warn", "~/.codex/config.toml",
                                       f"unrecognized marketplace [marketplaces.{name}] registered "
                                       f"— deregister it here or it re-clones"))
                        continue
                    # (name, source) — a known name is not enough: a foreign installer
                    # reusing it clobbers our registration and passed green (lq-d45051fa).
                    ident = _codex_marketplace_identity(entry)
                    if name == "personal":
                        src = entry.get("source") if isinstance(entry, dict) else None
                        if (not ident or not ident.startswith("local:")
                                or not _is_orchestratormaxxing_checkout(src)):
                            issues.append(("warn", "~/.codex/config.toml",
                                           f"[marketplaces.personal] does not point at a "
                                           f"orchestratormaxxing checkout (source={src!r}) — a foreign "
                                           f"registration is reusing the reserved name"))
                    elif name in KNOWN_CODEX_MARKETPLACE_SOURCES:
                        if ident not in KNOWN_CODEX_MARKETPLACE_SOURCES[name]:
                            issues.append(("warn", "~/.codex/config.toml",
                                           f"[marketplaces.{name}] reuses a known name with "
                                           f"unexpected source {ident or 'MISSING'} — a foreign "
                                           f"installer may have clobbered the registration"))

    claude_settings = os.path.join(home, ".claude", "settings.json")
    settings = None
    if os.path.isfile(claude_settings):
        try:
            with open(claude_settings, encoding="utf-8") as fh:
                settings = json.load(fh) or {}
        except Exception as ex:
            issues.append(("warn", "~/.claude/settings.json", f"unparseable JSON: {ex}"))
        else:
            for key in COMPACTION_OVERRIDE_KEYS["claude"]:
                if key in (settings.get("env") or {}):
                    issues.append(("error", "~/.claude/settings.json",
                                   compaction_override_msg("claude", key)))

    # --- P2: the deployed doctrine block survives in every context file ---
    for rel, label in ((os.path.join(".claude", "CLAUDE.md"), "~/.claude/CLAUDE.md"),
                       (os.path.join(".codex", "AGENTS.md"), "~/.codex/AGENTS.md"),
                       (os.path.join(".config", "opencode", "AGENTS.md"),
                        "~/.config/opencode/AGENTS.md"),
                       # Zed's always-on global Instructions file; the isfile
                       # skip below keeps Zed-less machines green.
                       (os.path.join(".config", "zed", "AGENTS.md"),
                        "~/.config/zed/AGENTS.md")):
        path = os.path.join(home, rel)
        if not os.path.isfile(path):
            continue
        text = open(path, encoding="utf-8", errors="replace").read()
        start, stop = text.find(DOCTRINE_BEGIN), text.find(DOCTRINE_END)
        if start == -1 or stop == -1:
            issues.append(("error", label,
                           "orchestratormaxxing doctrine block missing from a deployed context file "
                           "— something overwrote it; re-run ./install.sh"))
            continue
        block = text[start:stop]
        missing = [s for s in DOCTRINE_SENTINELS if s not in block]
        if missing:
            issues.append(("error", label,
                           f"doctrine block present but truncated — missing: {', '.join(missing)}"))

    # --- P3: no unrecognized hook fires in every project ---
    try:
        shipped_hook_tools = tuple(os.listdir(os.path.join(root, "bin")))
    except OSError:
        shipped_hook_tools = ()
    for event, groups in ((settings or {}).get("hooks") or {}).items():
        for group in groups if isinstance(groups, list) else []:
            for hook in (group or {}).get("hooks", []):
                command = (hook or {}).get("command", "")
                if command and not _hook_command_is_owned(command, root, shipped_hook_tools):
                    issues.append(("warn", "~/.claude/settings.json",
                                   f"unrecognized {event} hook fires in every project: "
                                   f"{command[:90]}"))

    # --- P4: no unrecognized plugin marketplace registered — the 2026-07-26 re-clone.
    # These are warn, not error: a registered marketplace is pre-positioning (it re-clones
    # even after its directory is deleted), not yet execution — that's P3's job once it
    # ships a hook — and a legit new user-added marketplace must not red the daily loop.
    known_markets = os.path.join(home, ".claude", "plugins", "known_marketplaces.json")
    if os.path.isfile(known_markets):
        try:
            with open(known_markets, encoding="utf-8") as fh:
                markets = json.load(fh) or {}
        except Exception as ex:
            issues.append(("warn", "~/.claude/plugins/known_marketplaces.json",
                           f"unparseable JSON: {ex}"))
        else:
            # Type-guard before use: this file is written by exactly the adversary the
            # check targets, and an uncaught exception here propagates out of audit() —
            # harness-verify then emits no JSON and loop-tick degrades to "observer
            # unavailable", i.e. a 3-byte file disables the gate (refuter, 2026-07-26).
            if not isinstance(markets, dict):
                issues.append(("warn", "~/.claude/plugins/known_marketplaces.json",
                               f"unexpected top-level type {type(markets).__name__} — "
                               f"expected an object of marketplace entries"))
            else:
                for name, entry in markets.items():
                    if name not in KNOWN_PLUGIN_MARKETPLACES:
                        issues.append(("warn", "~/.claude/plugins/known_marketplaces.json",
                                       f"unrecognized marketplace {name!r} registered — it will "
                                       f"RE-CLONE even if its directory is deleted; deregister "
                                       f"here first"))
                    elif name in KNOWN_PLUGIN_MARKETPLACE_SOURCES:
                        ident = _claude_marketplace_identity(entry)
                        if ident not in KNOWN_PLUGIN_MARKETPLACE_SOURCES[name]:
                            issues.append(("warn", "~/.claude/plugins/known_marketplaces.json",
                                           f"marketplace {name!r} reuses a known name with "
                                           f"unexpected source {ident or 'MISSING'} — a foreign "
                                           f"installer may have clobbered the registration"))

    installed_plugins = os.path.join(home, ".claude", "plugins", "installed_plugins.json")
    if os.path.isfile(installed_plugins):
        try:
            with open(installed_plugins, encoding="utf-8") as fh:
                installed = json.load(fh) or {}
        except Exception as ex:
            issues.append(("warn", "~/.claude/plugins/installed_plugins.json",
                           f"unparseable JSON: {ex}"))
        else:
            plugins = installed.get("plugins") if isinstance(installed, dict) else None
            if not isinstance(installed, dict) or (
                    plugins is not None and not isinstance(plugins, dict)):
                issues.append(("warn", "~/.claude/plugins/installed_plugins.json",
                               f"unexpected structure ({type(installed).__name__}) — "
                               f"expected an object with a 'plugins' object"))
            else:
                for key in (plugins or {}):
                    if "@" not in key:
                        issues.append(("warn", "~/.claude/plugins/installed_plugins.json",
                                       f"malformed plugin key {key!r} (expected name@marketplace)"))
                        continue
                    marketplace_name = key.rsplit("@", 1)[-1]
                    if marketplace_name not in KNOWN_PLUGIN_MARKETPLACES:
                        issues.append(("warn", "~/.claude/plugins/installed_plugins.json",
                                       f"plugin {key!r} installed from an unrecognized marketplace"))

    # settings.json is itself a REGISTRATION surface: Claude Code re-materializes the
    # plugins/ registries from extraKnownMarketplaces / enabledPlugins, so a foreign
    # entry here survives cleaning the registry files — the same "deleted the view, not
    # the registration" failure one layer up (refuter, 2026-07-26).
    extra_markets = (settings or {}).get("extraKnownMarketplaces")
    if isinstance(extra_markets, dict):
        for name, entry in extra_markets.items():
            if name not in KNOWN_PLUGIN_MARKETPLACES:
                issues.append(("warn", "~/.claude/settings.json",
                               f"unrecognized marketplace {name!r} in extraKnownMarketplaces — "
                               f"this re-materializes the plugins/ registries; remove it here "
                               f"first"))
            elif name in KNOWN_PLUGIN_MARKETPLACE_SOURCES:
                ident = _claude_marketplace_identity(entry)
                if ident not in KNOWN_PLUGIN_MARKETPLACE_SOURCES[name]:
                    issues.append(("warn", "~/.claude/settings.json",
                                   f"extraKnownMarketplaces {name!r} reuses a known name with "
                                   f"unexpected source {ident or 'MISSING'} — a foreign "
                                   f"installer may have clobbered the registration"))
    enabled_plugins = (settings or {}).get("enabledPlugins")
    if isinstance(enabled_plugins, dict):
        for key in enabled_plugins:
            marketplace_name = key.rsplit("@", 1)[-1] if "@" in key else None
            if marketplace_name not in KNOWN_PLUGIN_MARKETPLACES:
                issues.append(("warn", "~/.claude/settings.json",
                               f"plugin {key!r} enabled from an unrecognized marketplace"))

    # --- P5: no RETIRED tool is still executable on PATH (lq-68ae90d6) ---
    # install.sh adds and updates but never prunes, so deleting bin/<tool> from the repo
    # leaves ~/.local/bin/<tool> on every machine that already installed it. Verified on
    # the Mac 2026-07-18: after pulling the commit that deleted bin/context-lifecycle and
    # re-running install.sh, ~/.local/bin/context-lifecycle was still there and still
    # executable — a tool whose whole point was that it must stop existing. This gate
    # reported green throughout, because it only ever read the repo.
    # A prune step in install.sh is load-bearing and human-gated; until it lands, the
    # least this guard owes is to SEE the orphan instead of certifying the machine clean.
    # warn, not error, on purpose: the remedy is an `rm` on a possibly different machine,
    # and an error would red the daily loop (halt-and-alert) over a leftover file rather
    # than a broken harness — same call as every other deployed-state drift here.
    # Known consequence, stated so nobody reads more into this than it does: loop-tick
    # enqueues only ERROR-severity issues, so an orphan is visible to a human reading
    # harness-verify (and to any --json consumer) but is NOT auto-queued. Seeing it is
    # strictly more than the gate did before; acting on it — a prune step in install.sh,
    # or teaching the watcher to enqueue this warn — is what keeps lq-68ae90d6 open.
    bin_dst = os.path.join(home, ".local", "bin")
    retired, measured = retired_bin_names(root)
    if not measured:
        issues.append(("warn", "~/.local/bin",
                       "retired-tool scan did not run (git history unreadable) — this is "
                       "no signal, not a clean result; orphaned bridges would be invisible"))
    elif os.path.isdir(bin_dst):
        try:
            still_shipped = set(os.listdir(os.path.join(root, "bin")))
        except OSError:
            still_shipped = set()
        # Subtract what bin/ ships TODAY: a name deleted and later re-added is current,
        # not retired, and must not be reported as an orphan.
        for name in sorted(retired - still_shipped):
            if os.path.exists(os.path.join(bin_dst, name)):
                issues.append(("warn", "~/.local/bin",
                               f"{name} is still deployed but the repo no longer ships "
                               f"bin/{name} — install.sh never prunes; remove it with "
                               f"`rm ~/.local/bin/{name}`"))

    return issues


def audit(root):
    issues = []  # (severity, where, message)
    contract_results = []
    def err(w, m): issues.append(("error", w, m))
    def warn(w, m): issues.append(("warn", w, m))

    def fn_contract(contract_id, fn, where, tools,
                    prefix="behavioral contract failed"):
        # Function-contract dispatch with the mut-lock liveness skip; the skip
        # result joins contract_results so it is counted, never silent.
        res = run_function_contract(root, contract_id, fn, where, tools,
                                    err, warn, prefix)
        if res is not None:
            contract_results.append(res)

    bindir = os.path.join(root, "bin")
    install = os.path.join(root, "install.sh")
    claude_md = os.path.join(root, "CLAUDE.md")
    cmd_dir = os.path.join(root, ".claude", "commands")
    agent_dir = os.path.join(root, ".claude", "agents")
    codex_agent_dir = os.path.join(root, ".codex", "agents")
    codex_config = os.path.join(root, ".codex", "config.toml")
    codex_design = os.path.join(root, "knowledge", "codex-harness-design.md")
    plugin_dir = os.path.join(root, "plugins", "orchestratormaxxing")
    plugin_manifest = os.path.join(plugin_dir, ".codex-plugin", "plugin.json")
    plugin_hooks = os.path.join(plugin_dir, "hooks", "hooks.json")
    plugin_skills = os.path.join(plugin_dir, "skills")
    marketplace = os.path.join(root, ".agents", "plugins", "marketplace.json")

    install_txt = open(install).read() if os.path.isfile(install) else ""
    if not install_txt:
        err("install.sh", "missing — cannot verify deploy coverage")
    # The private fleet half (install-fleet.sh) deploys the tools that never graduate to the
    # public project. Deploy coverage, chmod consistency, and command/agent/skill wiring are
    # judged over BOTH installers; the graduated tree simply has no fleet half.
    fleet_install = os.path.join(root, "install-fleet.sh")
    fleet_present = os.path.isfile(fleet_install)
    if fleet_present:
        install_txt = install_txt + "\n" + open(fleet_install).read()

    # --- Execution/Tool layer: every bin/* tool parses, exec, shebang ---
    tools = []
    if os.path.isdir(bindir):
        tools = [os.path.join("bin", f) for f in sorted(os.listdir(bindir))
                 if os.path.isfile(os.path.join(bindir, f))
                 and not f.endswith((".mut-lock", ".mut-orig"))]

    for rel in tools:
        p = os.path.join(root, rel)
        # A live bin/mut run rewrites the source in place per mutant; the on-disk
        # file is a mutant, not a regression. Skip it rather than red on an artifact
        # (signal-vs-artifact: two false REDs on 2026-07-18 came from exactly this).
        mpid = mut_lock_live_pid(p)
        if mpid:
            warn(rel, f"mut run in progress (pid {mpid}) — syntax check skipped this pass")
            continue
        if os.path.exists(p + ".mut-orig"):
            err(rel, "interrupted mut run left a backup — source may be a mutant; "
                     "re-run bin/mut on it (auto-recovers) or restore from the .mut-orig file")
            continue
        ok, detail = syntax_ok(p)
        if not ok:
            err(rel, f"syntax error: {detail}")
        if not os.access(p, os.X_OK):
            warn(rel, "not executable (chmod +x)")
        with open(p, "rb") as fh:
            if not fh.readline().startswith(b"#!"):
                warn(rel, "no shebang line")

    # --- Tool layer: portability — no bare in-place sed in any shell script ---
    # NO spelling of bare `sed -i` is portable: BSD sed reads the script as the -i
    # suffix (`sed -i 'expr' file` → "invalid command code", the exact macOS-only
    # contract red of 2026-08-13, lq-09c00748), while GNU sed rejects the BSD
    # `sed -i '' ...` form. Portable rewrites: python3 (what the fix used) or an
    # attached-suffix `sed -i.bak file && rm file.bak`. This harness runs on both
    # machines, so a GNU-only sed is a red the author's own machine never shows.
    sed_inplace_re = re.compile(
        r"\bsed\s+(?:-[A-Za-z]+\s+)*(?:-i(?:\s+(?:''|\"\"))?(?=\s)|--in-place\b)")
    shell_scripts = []
    for rel in tools:
        with open(os.path.join(root, rel), "rb") as fh:
            if b"sh" in fh.readline():
                shell_scripts.append(rel)
    for dirname in ("tests", "shell", "deploy"):
        for dirpath, _, files in os.walk(os.path.join(root, dirname)):
            for f in sorted(files):
                if f.endswith(".sh"):
                    shell_scripts.append(
                        os.path.relpath(os.path.join(dirpath, f), root))
    shell_scripts.extend(x for x in ("install.sh", "bootstrap.sh")
                         if os.path.isfile(os.path.join(root, x)))
    for rel in shell_scripts:
        try:
            lines = open(os.path.join(root, rel), encoding="utf-8",
                         errors="replace").read().splitlines()
        except OSError:
            continue
        for n, line in enumerate(lines, 1):
            if line.lstrip().startswith("#"):
                continue
            if sed_inplace_re.search(line):
                err(rel, f"line {n}: nonportable in-place sed (bare `sed -i`) — "
                         "BSD sed reads the script as the suffix (macOS red "
                         "lq-09c00748); rewrite with python3 or `sed -i.bak`")

    # --- Lifecycle/Governance: deploy coverage — every tool & command is in install.sh ---
    # A tool that exists but install.sh never copies = it won't reach a global install.
    for rel in tools:
        base = os.path.basename(rel)
        if install_txt and base not in install_txt:
            err(rel, f"exists but is never referenced in install.sh — global install won't ship it")

    # A tool can be cp'd to the global bindir but left out of the `chmod +x` line —
    # it then ships NON-EXECUTABLE and silently breaks, while this guard stays green.
    # Spec: every basename copied to $BIN_DST must also be made executable there.
    # Accept both `cp src "$BIN_DST/name"` (explicit) and `cp src "$BIN_DST/"` (dir dest →
    # basename from source). Checks against an EXPLICIT chmod list (our install.sh convention);
    # a glob `chmod +x "$BIN_DST/"*` would trip a false POSITIVE — which is the safe direction
    # for a guard (it flags loudly instead of silently passing a non-exec tool) and nudges back
    # to an explicit list. We never silently pass via a glob (no dangerous false negative).
    if install_txt:
        explicit_re = re.compile(r"\$BIN_DST/([\w.+-]+)")   # "$BIN_DST/oll"
        dir_dest_re = re.compile(r"\$BIN_DST/?$")           # "$BIN_DST" or "$BIN_DST/"
        copied, chmodded = set(), set()
        for line in install_txt.splitlines():
            s = line.strip()
            quoted = re.findall(r'"([^"]+)"', line)
            if s.startswith("cp ") and "$BIN_DST" in line and len(quoted) >= 2:
                src, dest = quoted[0], quoted[-1]
                m = explicit_re.search(dest)
                if m:
                    copied.add(m.group(1))
                elif dir_dest_re.search(dest):
                    copied.add(os.path.basename(src))
            elif "chmod" in line and "+x" in line and "$BIN_DST" in line:
                chmodded |= set(explicit_re.findall(line))
        for name in sorted(copied - chmodded):
            err("install.sh", f"{name} is copied to $BIN_DST but never chmod +x'd — ships non-executable")

    if os.path.isdir(cmd_dir):
        for f in sorted(os.listdir(cmd_dir)):
            if f.endswith(".md") and install_txt and f not in install_txt:
                err(f".claude/commands/{f}", "command not wired into install.sh")
    if os.path.isdir(agent_dir):
        for f in sorted(os.listdir(agent_dir)):
            if f.endswith(".md") and install_txt and f not in install_txt:
                err(f".claude/agents/{f}", "agent not wired into install.sh")

    # Hermes skills (skills/<name>/SKILL.md) and Codex plugin skills
    # (plugins/orchestratormaxxing/skills/<name>/SKILL.md) had NO deploy coverage
    # until 2026-08-05, which is a measured hole and not a hypothetical one:
    # ~/.hermes/skills/plan-to-repo/SKILL.md exists on this box as a hand-placed
    # file with no source in any tree, so nothing could re-deploy or review it.
    # Same substring rule as the lanes above — necessary, not sufficient, but it
    # is exactly what catches "authored a skill, never wired it".
    # A skill is also wired when it is an entry of a governed manifest that an installer runs
    # (skills/external-stack.json for the core, skills/fleet-stack.json for the private fleet half).
    manifest_paths = set()
    for mf in ("skills/external-stack.json", "skills/fleet-stack.json"):
        mp = os.path.join(root, mf)
        if os.path.isfile(mp) and mf in install_txt:
            try:
                for item in json.load(open(mp)).get("skills", []):
                    if str(item.get("repo", "")).startswith("local://") and item.get("path"):
                        manifest_paths.add(item["path"].rstrip("/"))
            except (OSError, ValueError, AttributeError):
                pass
    for skills_root, label in (
        (os.path.join(root, "skills"), "skills"),
        (os.path.join(root, "plugins", "orchestratormaxxing", "skills"), "plugins/orchestratormaxxing/skills"),
    ):
        if not os.path.isdir(skills_root) or not install_txt:
            continue
        for name in sorted(os.listdir(skills_root)):
            d = os.path.join(skills_root, name)
            if not os.path.isdir(d) or not os.path.isfile(os.path.join(d, "SKILL.md")):
                continue
            # The Codex lane ships as one plugin: a reference to the plugin
            # directory covers every skill inside it, so accept either form.
            if name in install_txt or "plugins/orchestratormaxxing" in install_txt and label.startswith("plugins/"):
                continue
            if f"{label}/{name}" in manifest_paths:
                continue
            err(f"{label}/{name}", "skill not wired into install.sh — won't reach a global install")

    # Codex custom agents are project-local TOML and copied globally by install.sh.
    if os.path.isdir(codex_agent_dir):
        if ".codex/agents" not in install_txt:
            err(".codex/agents", "Codex agents not wired into install.sh")
        for f in sorted(os.listdir(codex_agent_dir)):
            if not f.endswith(".toml"):
                continue
            rel = f".codex/agents/{f}"
            try:
                with open(os.path.join(codex_agent_dir, f), "rb") as fh:
                    data = tomllib.load(fh)
                missing = [k for k in ("name", "description", "developer_instructions")
                           if not isinstance(data.get(k), str) or not data[k].strip()]
                if missing:
                    err(rel, f"missing required custom-agent fields: {', '.join(missing)}")
            except Exception as ex:
                err(rel, f"invalid TOML: {ex}")

        sol_planner = os.path.join(codex_agent_dir, "sol-planner.toml")
        if os.path.isfile(sol_planner):
            with open(sol_planner, "rb") as fh:
                sol = tomllib.load(fh)
            if sol.get("model") != "gpt-5.6-sol" or sol.get("model_reasoning_effort") != "ultra":
                err(".codex/agents/sol-planner.toml",
                    "Codex planner must pin gpt-5.6-sol with ultra reasoning")
            if sol.get("sandbox_mode") != "read-only":
                err(".codex/agents/sol-planner.toml", "Codex planner must stay read-only")
            if "EXECUTION SHAPE" not in sol.get("developer_instructions", ""):
                err(".codex/agents/sol-planner.toml",
                    "Codex planner must classify root-direct versus fanout execution")
        else:
            err(".codex/agents/sol-planner.toml", "missing Codex Sol planner")
        if os.path.isfile(os.path.join(codex_agent_dir, "fable-planner.toml")):
            err(".codex/agents/fable-planner.toml",
                "Fable planner is Claude-only; Codex must use sol-planner")

    # Context compaction is host-native and stays that way. This guard is unconditional and
    # standalone on purpose: on 2026-07-17 we shipped a `context-lifecycle` tool that wrote
    # uncalibrated overrides into global host config on every install, taking observed Claude
    # compactions from ~0.8/day to 63/day. The tool is gone; this is what stops it coming back.
    # Post-mortem: knowledge/context-lifecycle.md.
    claude_settings = os.path.join(root, ".claude", "settings.json")
    try:
        with open(claude_settings) as fh:
            claude_env = (json.load(fh) or {}).get("env") or {}
    except Exception:
        claude_env = {}
    for key in COMPACTION_OVERRIDE_KEYS["claude"]:
        if key in claude_env:
            err(".claude/settings.json", compaction_override_msg("claude", key))

    # Nothing in the installer may write compaction config into a host. The deleted tool is
    # named explicitly so a resurrection trips the guard before it reaches anyone's machine.
    inst = os.path.join(root, "install.sh")
    if os.path.isfile(inst):
        with open(inst) as fh:
            # Comment lines are exempt: the file documents WHY it writes no compaction config
            # and points at the post-mortem. Only executable lines can actually deploy anything.
            body = "\n".join(ln for ln in fh.read().splitlines()
                             if not ln.lstrip().startswith("#"))
        if "context-lifecycle" in body:
            err("install.sh",
                "references the removed `context-lifecycle` tool — the installer must never "
                "write compaction config into host settings (see knowledge/context-lifecycle.md)")
        for key in COMPACTION_OVERRIDE_KEYS["claude"] + COMPACTION_OVERRIDE_KEYS["codex"]:
            if key in body:
                err("install.sh", f"installer writes compaction override {key} into host config")

    # A shell contract must never report a PASS as a FAIL. Under `set -o pipefail`,
    # `<producer> | grep -q PATTERN` returns 141 (SIGPIPE) whenever `grep -q` matches and
    # exits while the upstream process is still writing: the pattern WAS found, yet the
    # pipeline reports failure, so the assertion inverts. It is a scheduling race, so it
    # only bites under load — measured 2026-08-26 at 349/2000 (17.5%) for `cat f | grep -q`
    # on a 3-line file with 16 competing CPU hogs, and 0/2000 for every alternative below.
    # That is what twice turned tests/loop-claim green-standalone / red-inside-a-full-pass
    # (lq-a1da289b), and because loop-tick auto-enqueues harness-verify reds, each false red
    # manufactures a phantom queued flaw — the same misreport class as the watcher timeout.
    # Fix at the call site, three equivalent forms, all SIGPIPE-free because the reader
    # consumes to EOF (or there is no pipe at all):
    #     producer | grep PATTERN >/dev/null      grep -q PATTERN file      grep -q P <<<"$v"
    # `grep -q` alone (no pipe) stays allowed — it cannot signal anything. Exit status is
    # preserved: every flag combination this repo uses (-v -F -E -i and pairs, match and
    # no-match) was measured identical between the two forms, and no site passes grep a FILE
    # operand, which is the only case where `-q`'s "match beats a later read error" rule can
    # diverge (0 vs 2). Two limits, STATED rather than hidden (both raised by the 2026-08-26
    # refutation critics, neither occurring anywhere in tests/ today):
    #   • The rewrite assumes a FINITE producer. `yes x | grep -q x` terminates; the >/dev/null
    #     form would not. A contract that genuinely needs early termination must handle the
    #     pipeline deliberately — tripping this lint is the point, not an obstacle.
    #   • Detection is single-line and reads flag clusters plus --quiet/--silent before the
    #     pattern; a `-q` written AFTER the pattern (`grep -e P -q`) is not caught.
    for rel in sorted({f for f in shell_scripts
                       if f.replace(os.sep, "/").startswith("tests/")}):
        try:
            lines = open(os.path.join(root, rel), encoding="utf-8",
                         errors="replace").read().splitlines()
        except OSError:
            continue
        shebang = lines[0] if lines else ""
        if not (("pipefail" in shebang) or
                any(ln.lstrip().startswith("set ") and "pipefail" in ln
                    and "+o pipefail" not in ln for ln in lines)):
            continue
        for n, ln in enumerate(lines, 1):
            if ln.lstrip().startswith("#"):
                continue
            for m in re.finditer(
                    r"(?<!\|)\|(?!\|)\s*grep\b((?:\s+--?[A-Za-z-]+)*)", ln):
                flags = m.group(1).split()
                if any(f in ("--quiet", "--silent") or
                       (not f.startswith("--") and "q" in f) for f in flags):
                    err(rel, f"line {n}: `| grep -q` under pipefail returns 141 (SIGPIPE) when "
                             "the pattern matches and the producer is still writing, so a "
                             "PASSING assertion reads as a FAIL under load. Use "
                             "`| grep PATTERN >/dev/null`, or grep the file directly")
                    break

    # Project Codex config must parse and keep conservative fan-out bounds.
    if os.path.isfile(codex_config):
        try:
            with open(codex_config, "rb") as fh:
                cfg = tomllib.load(fh)
            agents = cfg.get("agents") or {}
            if agents.get("max_depth") != 1:
                err(".codex/config.toml", "agents.max_depth must stay 1 (no recursive fan-out)")
            if not isinstance(agents.get("max_threads"), int) or agents["max_threads"] > 6:
                err(".codex/config.toml", "agents.max_threads must be an integer <= 6")
            for key in COMPACTION_OVERRIDE_KEYS["codex"]:
                if key in cfg:
                    err(".codex/config.toml", compaction_override_msg("codex", key))

            if not os.path.isfile(claude_md):
                err("CLAUDE.md", "missing shared project doctrine")
            elif cfg.get("project_doc_max_bytes", 0) < os.path.getsize(claude_md):
                err(".codex/config.toml", "project_doc_max_bytes is smaller than shared doctrine")
        except Exception as ex:
            err(".codex/config.toml", f"invalid TOML: {ex}")
    else:
        err(".codex/config.toml", "missing Codex project adapter")

    # Plugin package: manifest, marketplace, hooks, and every skill frontmatter.
    for path, rel in ((plugin_manifest, "plugins/orchestratormaxxing/.codex-plugin/plugin.json"),
                      (plugin_hooks, "plugins/orchestratormaxxing/hooks/hooks.json"),
                      (marketplace, ".agents/plugins/marketplace.json")):
        if not os.path.isfile(path):
            err(rel, "missing")
            continue
        try:
            data = json.load(open(path))
            if not isinstance(data, dict):
                raise ValueError("root must be an object")
        except Exception as ex:
            err(rel, f"invalid JSON: {ex}")

    if os.path.isfile(plugin_manifest):
        manifest = json.load(open(plugin_manifest))
        if manifest.get("name") != "orchestratormaxxing" or manifest.get("skills") != "./skills/":
            err("plugins/orchestratormaxxing/.codex-plugin/plugin.json",
                "manifest must name orchestratormaxxing and point skills at ./skills/")
        plugin_install_contract = ("orchestratormaxxing@personal", "codex plugin add",
                                   "codex plugin list --json", 'p.get("installed") is True',
                                   'p.get("enabled") is True')
        if any(token not in install_txt for token in plugin_install_contract):
            err("plugins/orchestratormaxxing",
                "install.sh must register, install, and verify the plugin is installed+enabled")
        prompts = (manifest.get("interface") or {}).get("defaultPrompt") or []
        sol_i = next((i for i, p in enumerate(prompts) if "$orchestratormaxxing:solplan" in p), None)
        fan_i = next((i for i, p in enumerate(prompts) if "$orchestratormaxxing:fanout" in p), None)
        if sol_i is None or fan_i is None or sol_i >= fan_i:
            err("plugins/orchestratormaxxing/.codex-plugin/plugin.json",
                "default prompts must prioritize solplan before fanout")
        if "EXPECTED_PLUGIN_VERSION" not in install_txt or 'p.get("version") == expected' not in install_txt:
            err("install.sh", "Codex plugin install must verify the exact manifest version")

    if os.path.isfile(plugin_hooks):
        hooks = json.load(open(plugin_hooks)).get("hooks") or {}
        required_hook_events = {"SessionStart", "UserPromptSubmit", "PermissionRequest",
                                "PreToolUse", "PostToolUse", "Stop"}
        missing_hook_events = required_hook_events - set(hooks)
        if missing_hook_events:
            err("plugins/orchestratormaxxing/hooks/hooks.json",
                f"missing lifecycle hooks: {', '.join(sorted(missing_hook_events))}")
        hook_text = open(plugin_hooks).read()
        for command in ("mem-audit", "loop-tick", "session-log", "agent-tab-status",
                        "warp-agent-event", "warp-agent-recovery", "codex-stop-hook"):
            if command not in hook_text:
                err("plugins/orchestratormaxxing/hooks/hooks.json", f"missing {command} lifecycle wiring")
        hook_commands = [hook.get("command", "") for phase in hooks.values()
                         for group in phase for hook in group.get("hooks", [])]
        if any("SOLPLAN_CHILD" not in command for command in hook_commands):
            err("plugins/orchestratormaxxing/hooks/hooks.json",
                "every lifecycle hook must skip bounded Solplan children")
        loop_hooks = [hook for group in hooks.get("SessionStart", [])
                      for hook in group.get("hooks", [])
                      if "loop-tick" in hook.get("command", "")]
        if (not loop_hooks
                or any("loop-tick --kick --quiet" not in hook.get("command", "")
                       or "loop-tick --gate" in hook.get("command", "")
                       for hook in loop_hooks)):
            err("plugins/orchestratormaxxing/hooks/hooks.json",
                "SessionStart watcher must kick the verifier asynchronously, never gate inline")
        if any(not 0 < hook.get("timeout", 0) <= 15 for hook in loop_hooks):
            err("plugins/orchestratormaxxing/hooks/hooks.json",
                "asynchronous loop-tick hook budget must stay within 15s")
        if ('loop-tick --kick --quiet >/dev/null 2>&1' not in install_txt
                or '"timeout": 5, "statusMessage": "Watching harness health' not in install_txt):
            err("install.sh",
                "Claude loop-tick hook generator must install the shared non-blocking watcher")

    if os.path.isdir(plugin_skills):
        skills = [d for d in sorted(os.listdir(plugin_skills))
                  if os.path.isdir(os.path.join(plugin_skills, d))]
        required = {"fanout", "ideas", "self-improve", "wrap-up", "solplan", "memory", "graduate"}
        if fleet_present:
            required.add("product-manager")   # Hermes roadmap/kanban role: fleet-only
        missing = required - set(skills)
        if missing:
            err("plugins/orchestratormaxxing/skills", f"missing skills: {', '.join(sorted(missing))}")
        if "fableplan" in skills:
            err("plugins/orchestratormaxxing/skills/fableplan",
                "Fableplan is Claude-only; the Codex plugin must expose solplan")
        for name in skills:
            rel = f"plugins/orchestratormaxxing/skills/{name}/SKILL.md"
            path = os.path.join(root, rel)
            if not os.path.isfile(path):
                err(rel, "missing SKILL.md")
                continue
            text = open(path).read()
            if not text.startswith("---\n") or text.count("---") < 2:
                err(rel, "missing frontmatter")
                continue
            fm = text.split("---", 2)[1]
            if not re.search(r"(?m)^name:\s*\S+", fm) or not re.search(r"(?m)^description:\s*\S+", fm):
                err(rel, "frontmatter requires name and description")
        # Gauntlet promotion invariant: the blind panel's verdict may promote,
        # never accept — if either host's surface drops the sentence (or the
        # tool reference), the doctrine silently inverts into an LLM gate.
        for rel in (".claude/commands/gauntlet.md",
                    "plugins/orchestratormaxxing/skills/gauntlet/SKILL.md"):
            path = os.path.join(root, rel)
            text = open(path).read() if os.path.isfile(path) else ""
            if "gauntlet-judge" not in text or "promotes, never accepts" not in text:
                err(rel, "gauntlet promotion invariant missing "
                         "(needs `gauntlet-judge` + 'promotes, never accepts')")
        # Gauntlet positioning: incremental division ONE STEP BEFORE planning
        # (Ricardo, 2026-08-01 v2 — rolled back from default-execution-shape).
        # It divides the WHAT; fableplan/solplan keep the HOW. If a surface
        # drops the positioning, the loop drifts back into a planning layer.
        for rel, token in ((".claude/commands/gauntlet.md", "one step BEFORE planning"),
                           ("plugins/orchestratormaxxing/skills/gauntlet/SKILL.md", "one step BEFORE planning"),
                           ("CLAUDE.md", "one step BEFORE planning"),
                           ("plugins/orchestratormaxxing/.codex-plugin/plugin.json",
                            "gauntlet first to divide it into incremental parts")):
            path = os.path.join(root, rel)
            text = open(path).read() if os.path.isfile(path) else ""
            if token not in text:
                err(rel, f"gauntlet intake positioning missing (needs {token!r})")
        routing_contract = {
            "solplan": ("Prioritize this before $orchestratormaxxing:fanout", "EXECUTION SHAPE"),
            "fanout": ("Use only after planning is complete", "invoke `$orchestratormaxxing:solplan`"),
        }
        for name, tokens in routing_contract.items():
            path = os.path.join(plugin_skills, name, "SKILL.md")
            text = open(path).read() if os.path.isfile(path) else ""
            if any(token not in text for token in tokens):
                err(f"plugins/orchestratormaxxing/skills/{name}/SKILL.md",
                    "missing Codex plan-before-fanout routing contract")
            ui = os.path.join(plugin_skills, name, "agents", "openai.yaml")
            ui_text = open(ui).read() if os.path.isfile(ui) else ""
            if "planning" not in ui_text.lower() and "plan " not in ui_text.lower():
                err(f"plugins/orchestratormaxxing/skills/{name}/agents/openai.yaml",
                    "UI metadata must state the planning phase")
        # Body budget (docs/skill-style-guide.md). A skill body is charged on every turn
        # it is offered, so an over-budget skill is a permanent tax — worst for an
        # always-on one. Warn, not error: the budget is a convention we chose, and the
        # honest severity for a convention is a warning.
        for name in skills:
            path = os.path.join(plugin_skills, name, "SKILL.md")
            if not os.path.isfile(path):
                continue
            body = re.sub(r"^---.*?---", "", open(path, encoding="utf-8").read(),
                          count=1, flags=re.S)
            approx_tokens = int(len(body.split()) * 1.33)
            if approx_tokens > 1000:
                warn(f"plugins/orchestratormaxxing/skills/{name}/SKILL.md",
                     f"body ~{approx_tokens} tokens exceeds the 1000-token hard maximum "
                     f"(docs/skill-style-guide.md) — move detail into references/")

        weakest_guard = "VALIDITY-FIRST / WEAKEST-SUFFICIENT"
        for rel in (".claude/commands/self-improve.md",
                    "plugins/orchestratormaxxing/skills/self-improve/SKILL.md",
                    "bin/win-log", "knowledge/hermes-strategic-evolution-plan.md"):
            path = os.path.join(root, rel)
            try:
                text = open(path, errors="replace").read()
            except OSError:
                err(rel, "missing weakest-sufficient selection surface")
                continue
            if weakest_guard not in text:
                err(rel, f"missing selection invariant: {weakest_guard}")

        sol_runner = os.path.join(plugin_skills, "solplan", "scripts", "run_solplan.py")
        if not os.path.isfile(sol_runner):
            err("plugins/orchestratormaxxing/skills/solplan/scripts/run_solplan.py",
                "missing bounded Solplan runner")
        else:
            runner_text = open(sol_runner).read()
            runner_contract = ('model_reasoning_effort="ultra"', '"--ignore-user-config"',
                               '"--enable"', '"multi_agent"', '"agents.max_threads=4"',
                               '"agents.max_depth=1"', "subprocess.DEVNULL",
                               '"--json"', "start_new_session=True", "validate_plan",
                               "event_progress", "heartbeat_seconds",
                               "terminate_process_group", "JsonlFramer",
                               "MAX_EVENT_BYTES", "MAX_PLAN_BYTES", "O_NOFOLLOW")
            if any(token not in runner_text for token in runner_contract):
                err("plugins/orchestratormaxxing/skills/solplan/scripts/run_solplan.py",
                    "runner must stay Ultra, delegation-bounded, observable, cancellable, stdin-closed, and validated")
            if "timeout_seconds" in runner_text or "--timeout-seconds" in runner_text:
                err("plugins/orchestratormaxxing/skills/solplan/scripts/run_solplan.py",
                    "runner must not impose a wall-clock deadline on Sol Ultra")
            if "dangerously-bypass-hook-trust" in runner_text:
                err("plugins/orchestratormaxxing/skills/solplan/scripts/run_solplan.py",
                    "bounded planner must not force unrelated user hooks")
            runner_test = os.path.join(root, "tests", "solplan-runner", "test_solplan_runner.py")
            if not os.path.isfile(runner_test):
                err("tests/solplan-runner/test_solplan_runner.py",
                    "missing focused Solplan runner contract")
            else:
                test_env = os.environ.copy()
                test_env["PYTHONDONTWRITEBYTECODE"] = "1"
                try:
                    result = subprocess.run(
                        [sys.executable, runner_test], cwd=root, env=test_env,
                        capture_output=True, text=True, timeout=30,
                    )
                except subprocess.TimeoutExpired:
                    err("tests/solplan-runner/test_solplan_runner.py",
                        "focused Solplan runner contract timed out")
                else:
                    if result.returncode:
                        tail = "\n".join((result.stdout + result.stderr).splitlines()[-20:])
                        err("tests/solplan-runner/test_solplan_runner.py",
                            f"focused Solplan runner contract failed:\n{tail}")
    else:
        err("plugins/orchestratormaxxing/skills", "missing")

    # Shell adapters are sourced rather than executed, but still require syntax
    # checks and install coverage. zsh is checked when present.
    for rel in ("shell/claude-c.sh", "shell/codex-g.sh", "shell/opencode-o.sh"):
        path = os.path.join(root, rel)
        if not os.path.isfile(path):
            err(rel, "missing")
            continue
        r = subprocess.run(["bash", "-n", path], capture_output=True, text=True)
        if r.returncode:
            err(rel, f"bash syntax error: {r.stderr.strip().splitlines()[-1]}")
        zsh = shutil.which("zsh")
        if zsh:
            r = subprocess.run([zsh, "-n", path], capture_output=True, text=True)
            if r.returncode:
                err(rel, f"zsh syntax error: {r.stderr.strip().splitlines()[-1]}")
        if os.path.basename(path) not in install_txt:
            err(rel, "shell adapter not wired into install.sh")

    # Exact tmux session targets prevent prefix matches; display-message additionally needs
    # ':' so it resolves the session's current pane instead of returning empty with exit 0.
    for where, msg in shell_tmux_targets_ok(root):
        err(where, msg)

    # Human scrollback in tmux panes must route wheel-up to whichever layer can
    # actually scroll. Linux c/g keep durable normal-screen history (covered by
    # agent-scrollback); other mouse-reporting TUIs own their wheel events and
    # everything else gets tmux copy-mode. Deploy without replacing the user's
    # own ~/.tmux.conf.
    tmux_conf = os.path.join(root, "shell", "tmux.conf")
    if not os.path.isfile(tmux_conf):
        err("shell/tmux.conf", "missing managed tmux scrolling defaults")
    else:
        tmux_text = open(tmux_conf).read()
        for token in ("set-option -g mouse on", "set-option -g history-limit 100000",
                      "set-option -s set-clipboard external",
                      "set-option -g set-titles on", "set-option -g set-titles-string '#W'",
                      "set-option -g allow-passthrough on",
                      "bind-key -T root WheelUpPane if-shell -F -t = "
                      "'#{mouse_any_flag}' 'send-keys -M' "
                      "'copy-mode -e; send-keys -X -N 5 scroll-up'"):
            if token not in tmux_text:
                err("shell/tmux.conf", f"missing scrolling contract: {token}")
        for token in ("shell/tmux.conf", "orchestratormaxxing:tmux", "tmux source-file"):
            if token not in install_txt:
                err("install.sh", f"tmux defaults not fully deployed: missing {token}")

    # deploy/ holds the autonomous-loop glue templates (wrapper + launchd plist). Same rule:
    # a template install.sh never deploys is dead weight that drifts from the live copy.
    deploy_dir = os.path.join(root, "deploy")
    if os.path.isdir(deploy_dir):
        for f in sorted(os.listdir(deploy_dir)):
            if os.path.isfile(os.path.join(deploy_dir, f)) and install_txt and f not in install_txt:
                err(f"deploy/{f}", "deploy template not referenced in install.sh — won't reach live locations")

    # orchestrator/deploy/ holds the dashboard's own systemd units. Same rule, and it
    # bit us on 2026-08-11: six hermes timers were live on this machine but installed
    # BY HAND, so a fresh machine (or a re-install) silently had no scorecard, no
    # backup, no funnel snapshot and no Friday brief. A unit that only exists because
    # somebody once ran `cp` is not deployed — it is remembered.
    orch_deploy = os.path.join(root, "orchestrator", "deploy")
    if os.path.isdir(orch_deploy):
        # Only systemd units: the compose files and helper scripts in that directory
        # are consumed by docker/cron directly and have no business in install.sh.
        for f in sorted(os.listdir(orch_deploy)):
            if not f.endswith((".service", ".timer")):
                continue
            if os.path.isfile(os.path.join(orch_deploy, f)) and install_txt and f not in install_txt:
                err(f"orchestrator/deploy/{f}",
                    "unit template not referenced in install.sh — a fresh machine gets no timer")

        # :5555 is the Tailscale HTTPS terminator, not the dashboard backend.
        # The live Serve route, stdio MCP proxy and local jobs all target :3000.
        # Copying a unit that binds the backend to :5555 makes the process look
        # healthy locally while every real consumer gets connection-refused/502.
        dashboard_unit = os.path.join(orch_deploy, "hermes-dashboard.service")
        if os.path.isfile(dashboard_unit):
            dashboard_unit_text = open(dashboard_unit).read()
            if "Environment=DASHBOARD_PORT=3000" not in dashboard_unit_text:
                err("orchestrator/deploy/hermes-dashboard.service",
                    "dashboard backend must bind loopback :3000; Tailscale terminates HTTPS on :5555")

    # A deploy/ wrapper that runs repo-scoped tools MUST cd into the repo first. intent-queue and
    # loop-queue resolve their queue path from `git rev-parse` with an os.getcwd() FALLBACK, so a
    # wrapper that never cds fails OPEN, not loud: systemd --user starts it in $HOME, the fallback
    # writes a plausible-looking queue OUTSIDE the repo, and everything enqueued is invisible
    # forever. Observed live 2026-08-10 — hermes-strategic-brief.sh (unlike its sibling
    # loop-cron.sh) never cd'd, so $HOME/knowledge/intent-queue.jsonl accumulated 3 open
    # load-bearing SELECT intents over 3 weeks that no gate, watcher, or human ever read.
    repo_scoped = ("hermes-watch", "intent-queue", "loop-queue", "loop-tick", "win-log", "session-log", "kpi-brief")
    if os.path.isdir(deploy_dir):
        for f in sorted(os.listdir(deploy_dir)):
            if not f.endswith(".sh"):
                continue
            wrapper = os.path.join(deploy_dir, f)
            try:
                wtxt = open(wrapper).read()
            except OSError:
                continue
            if 'REPO="__REPO__"' not in wtxt:
                continue
            used = sorted({t for t in repo_scoped if t in wtxt})
            if used and not re.search(r'^\s*cd\s+"\$REPO"', wtxt, re.M):
                err(f"deploy/{f}", "runs repo-scoped tool(s) " + ", ".join(used) +
                    ' but never `cd "$REPO"` — queue/log paths fall back to cwd and land outside the repo')

    # --- install.sh orchestrator block markers must be present + balanced ---
    if install_txt:
        b = install_txt.count("orchestratormaxxing:orchestrator:begin")
        e = install_txt.count("orchestratormaxxing:orchestrator:end")
        if b == 0 or e == 0:
            err("install.sh", "orchestrator block markers missing (begin/end)")
        elif b != e:
            err("install.sh", f"unbalanced orchestrator markers (begin={b} end={e})")
        routing = "Codex plan-first routing"
        if routing not in install_txt:
            err("install.sh", "global Codex doctrine must deploy plan-first routing")

    # --- Tool/Context: no dispatch surface may reference a RETIRED worker model ---
    # A retired id (410) on a routing/dispatch surface breaks delegations at dispatch time while
    # syntax stays green. Errors on tools/agents/commands/README (auto-fixable surfaces); WARN
    # only on CLAUDE.md — the doctrine prune is human-gated (unattended rounds stop at SELECT),
    # and an error here would leave the guard red until sign-off, halting the loop on its own
    # pending proposal. harness-verify itself is exempt (it carries the denylist).
    retired_surfaces = [
        rel for rel in tools
        if os.path.basename(rel) not in ("harness-verify", "oll")
    ]
    for d, pat in ((cmd_dir, ".claude/commands"), (agent_dir, ".claude/agents")):
        if os.path.isdir(d):
            retired_surfaces += [f"{pat}/{f}" for f in sorted(os.listdir(d)) if f.endswith(".md")]
    if os.path.isfile(os.path.join(root, "README.md")):
        retired_surfaces.append("README.md")
    for rel in retired_surfaces:
        try:
            txt = open(os.path.join(root, rel), errors="replace").read()
        except OSError:
            continue
        # a line that names retired IDs in order to BLOCK them (a RETIRED_*
        # denylist, e.g. win-log's liveness demotion) is enforcement, not use —
        # only that context is exempt, and only line-scoped
        live_lines = "\n".join(l for l in txt.splitlines() if "RETIRED_" not in l)
        for mid in RETIRED_MODELS:
            if re.search(rf"(?<![A-Za-z0-9_.:-]){re.escape(mid)}(?![A-Za-z0-9_.:-])", live_lines):
                err(rel, f"references retired Ollama Cloud model '{mid}' (410 — prune or replace)")
    if os.path.isfile(claude_md):
        cm_txt = open(claude_md, errors="replace").read()
        for mid in RETIRED_MODELS:
            if re.search(rf"(?<![A-Za-z0-9_.:-]){re.escape(mid)}(?![A-Za-z0-9_.:-])", cm_txt):
                warn("CLAUDE.md", f"worker list references retired model '{mid}' — doctrine prune awaiting human sign-off")

    # --- Tool/Governance: normal fanout has one executable model policy ---
    oll_policy_path = os.path.join(bindir, "oll")
    expected_workers = ("deepseek-v4-flash:0731", "glm-5.3", "kimi-k3", "kimi-k2.7-code", "qwen3.5:397b")
    expected_replacements = {
        "glm-4.7": "glm-5.3",
        "glm-5": "glm-5.3",
        "glm-5.1": "glm-5.3",
        "glm-5.2": "glm-5.3",
        "kimi-k2.5": "kimi-k2.7-code",
        "kimi-k2.6": "kimi-k2.7-code",
        "kimi-k2-thinking": "kimi-k2.7-code",
        "qwen3-coder-next": "qwen3.5:397b",
        "qwen3-coder:480b": "qwen3.5:397b",
        "qwen3-vl:235b": "qwen3.5:397b",
    }
    legacy_workers = tuple(expected_replacements)
    try:
        tree = ast.parse(open(oll_policy_path, errors="replace").read(), filename=oll_policy_path)
        policy = {}
        wanted = {
            "DEFAULT_MODEL", "REASONING_MODEL", "NORMAL_WORKER_MODELS",
            "LEGACY_MODEL_REPLACEMENTS",
        }
        for node in tree.body:
            if not isinstance(node, ast.Assign) or len(node.targets) != 1:
                continue
            target = node.targets[0]
            if isinstance(target, ast.Name) and target.id in wanted:
                policy[target.id] = ast.literal_eval(node.value)
        if policy.get("DEFAULT_MODEL") != "deepseek-v4-flash:0731":
            err("bin/oll", "normal default must be deepseek-v4-flash:0731")
        if policy.get("NORMAL_WORKER_MODELS") != expected_workers:
            err("bin/oll", f"normal worker pool must be exactly {expected_workers!r}")
        replacements = policy.get("LEGACY_MODEL_REPLACEMENTS")
        if replacements != expected_replacements:
            err("bin/oll", "legacy replacement map drifted from the modern worker pool")
    except Exception as ex:
        err("bin/oll", f"could not load worker model policy: {ex}")

    # --- Governance: no role may exceed its usage-class ceiling (lq-faefaa8c) ---
    # This is the check whose absence let commit a7e7a7b9 put the routine-fanout
    # default on the provider's most expensive tier for a week, on the strength
    # of a "medium usage" label that was simply wrong. Prose could not contradict
    # it; a comparison against the published catalog can.
    try:
        # ONE dict for globals and locals: with separate namespaces a
        # module-level `import os` binds into locals, while the functions
        # defined there capture globals — so they cannot see their own imports.
        oll_mod = {"__name__": "_oll_policy_probe", "__file__": oll_policy_path}
        exec(compile(open(oll_policy_path, errors="replace").read(),
                     oll_policy_path, "exec"), oll_mod)
        catalog = oll_mod["load_model_catalog"]()
        if catalog is None:
            warn("knowledge/model-catalog.json",
                 "absent — usage-class ceilings unenforceable; run `model-catalog refresh`")
        else:
            for v in oll_mod["usage_policy_violations"](catalog):
                if v["status"] == "over":
                    err("bin/oll",
                        f"role '{v['role']}' uses {v['model']} ({v['usage_label']}) "
                        f"above its {v['ceiling']} ceiling")
                else:
                    warn("bin/oll",
                         f"role '{v['role']}' uses {v['model']}, which the published "
                         "catalog does not cover — refresh before trusting the ceiling")
    except Exception as ex:
        err("bin/oll", f"usage-ceiling gate could not run: {ex}")

    baseline_surfaces = (
        "CLAUDE.md", "README.md", ".claude/commands/fanout.md",
        ".claude/agents/ollama-worker.md", ".codex/agents/ollama-worker.toml",
        "plugins/orchestratormaxxing/skills/fanout/SKILL.md",
        "knowledge/provider-routing.md", "orchestratormaxxing-architecture.svg",
    )
    operational_surfaces = baseline_surfaces + (
        "SETUP.md", "bootstrap.sh", "install.sh", "bin/oll-council",
        "bin/provider-ask", "bin/warp-ollama", "bin/win-log",
        "knowledge/warp-ollama-provider.md",
    )
    for rel in operational_surfaces:
        path = os.path.join(root, rel)
        try:
            text = open(path, errors="replace").read()
        except OSError:
            err(rel, "worker model policy surface missing")
            continue
        if rel in baseline_surfaces:
            for model in expected_workers:
                if model not in text:
                    err(rel, f"normal fanout baseline missing {model}")
        # same denylist exemption as the retired-surface lint: a RETIRED_* line
        # names legacy IDs to block them, never to recommend them
        text_live = "\n".join(l for l in text.splitlines() if "RETIRED_" not in l)
        for model in legacy_workers:
            if re.search(rf"(?<![A-Za-z0-9_.:-]){re.escape(model)}(?![A-Za-z0-9_.:-])", text_live):
                err(rel, f"recommends legacy normal-worker model {model}")

    # --- Context/Governance: CLAUDE.md keeps its load-bearing sections ---
    if os.path.isfile(claude_md):
        low = open(claude_md).read().lower()
        for h in REQUIRED_DOCTRINE:
            if h not in low:
                warn("CLAUDE.md", f"missing load-bearing doctrine section: '{h}'")
        if "codex plan-first routing" not in low:
            err("CLAUDE.md", "Codex adapter must prioritize solplan before fanout")
    else:
        err("CLAUDE.md", "missing")

    if not os.path.isfile(codex_design) or "routes nontrivial unplanned work through `$orchestratormaxxing:solplan` first" not in open(codex_design).read():
        err("knowledge/codex-harness-design.md",
            "Codex design must document solplan-before-fanout routing")

    # --- Governance: doc-inventory policy (lq-1f8b2552) ---
    # CLAUDE.md's tools section and README's table are explicitly CURATED, not
    # exhaustive; knowledge/tool-inventory.md is the exhaustive complement listing
    # every bin/ executable deliberately left out of the curated surfaces. A tool
    # in NEITHER is undocumented drift; a manifest line naming a tool that no
    # longer ships is rot; a tool in BOTH graduated without leaving the manifest.
    inventory_rel = os.path.join("knowledge", "tool-inventory.md")
    inventory_path = os.path.join(root, inventory_rel)
    readme_path = os.path.join(root, "README.md")
    curated_txt = (open(claude_md, errors="replace").read() if os.path.isfile(claude_md) else "") \
        + (open(readme_path, errors="replace").read() if os.path.isfile(readme_path) else "")
    bin_names = sorted(os.path.basename(t) for t in tools if t.startswith("bin"))
    if not os.path.isfile(inventory_path):
        err(inventory_rel, "missing — the doc-inventory policy manifest (curated "
                           "CLAUDE.md/README + exhaustive manifest, lq-1f8b2552)")
    else:
        inv_names = set(re.findall(r"^- `([^`]+)`", open(inventory_path, errors="replace").read(), re.M))
        for name in sorted(inv_names):
            if name not in bin_names:
                err(inventory_rel, f"lists `{name}` but bin/{name} does not ship — manifest rot")
        for name in bin_names:
            # Curated = named in CLAUDE.md or README.md as `name` or bin/name
            # (boundary-guarded: `oll` must not match inside `oll-council`).
            curated = (f"`{name}`" in curated_txt
                       or re.search(rf"bin/{re.escape(name)}(?![A-Za-z0-9_.-])", curated_txt))
            if not curated and name not in inv_names:
                err(f"bin/{name}", "undocumented: absent from CLAUDE.md/README.md AND "
                                   "knowledge/tool-inventory.md — curate it or add a manifest line")
            elif curated and name in inv_names:
                warn(inventory_rel, f"`{name}` is curated in CLAUDE.md/README.md and still in "
                                    "the manifest — drop the manifest line")

    # --- command frontmatter sanity ---
    if os.path.isdir(cmd_dir):
        for f in sorted(os.listdir(cmd_dir)):
            if not f.endswith(".md"):
                continue
            t = open(os.path.join(cmd_dir, f)).read()
            if not t.startswith("---") or "description:" not in t.split("---", 2)[1] if t.count("---") >= 2 else True:
                if not t.startswith("---"):
                    warn(f".claude/commands/{f}", "no frontmatter block")

    # --- Verification layer: mem-audit + mut still execute ---
    for tool, args in (("mem-audit", ["--json"]), ("mut", ["--help"])):
        p = os.path.join(bindir, tool)
        if os.path.isfile(p):
            try:
                r = subprocess.run([sys.executable, p, *args] if open(p).readline().find("python") > 0
                                   else [p, *args], capture_output=True, text=True, timeout=30)
                if tool == "mem-audit" and args == ["--json"]:
                    try:
                        json.loads(r.stdout)
                    except Exception:
                        err("bin/mem-audit", "--json did not emit valid JSON")
            except Exception as ex:
                err(f"bin/{tool}", f"failed to run: {ex}")

    # --- Verification layer: loop tools' BEHAVIOR (gate exit-code + idempotent add) ---
    # Syntax-green ≠ contract-green; exercise loop-queue's load-bearing contracts as a black box.
    fn_contract("loop-tools", loop_tools_behavior_ok, "bin/loop-queue",
                ("bin/loop-queue",))

    # The queue's TTL sweep is the one op that RESOLVES items on its own — assert its boundary
    # (research-only, age-gated, claimed-safe) or the drain that unblocks intake can eat a flaw.
    fn_contract("loop-queue-ttl", loop_queue_ttl_ok, "bin/loop-queue",
                ("bin/loop-queue",))

    # intent-queue (the proactive layer's forward state): gate exit-code + idempotent add +
    # sticky-dismiss (no re-nag). Same black-box posture as loop-queue.
    fn_contract("intent-queue", intent_queue_behavior_ok, "bin/intent-queue",
                ("bin/intent-queue",))

    # Consume-once under concurrency (2026-08-09, arXiv:2608.03836 shape): both queues'
    # mutating verbs must hold the bounded sidecar lock, claim must be CAS, reopen must be
    # countable, --repro must round-trip un-executed. Hermetic contract, proven red against
    # the pre-fix tools via a barrier-synchronized interleave (never launch-and-hope).
    qc = os.path.join(root, "tests", "queue-concurrency", "run.py")
    if os.path.isfile(qc):
        try:
            r = subprocess.run([sys.executable, qc], capture_output=True, text=True, timeout=120)
            if r.returncode != 0:
                tail = (r.stdout + "\n" + r.stderr).strip().splitlines()[-6:]
                err("tests/queue-concurrency", "consume-once contract failed: " + " | ".join(tail))
        except Exception as ex:
            err("tests/queue-concurrency", f"consume-once contract could not run: {ex}")
    else:
        err("tests/queue-concurrency", "contract file missing (run.py) — the consume-once "
                                       "guarantee is unverified")

    # Measured round cost ledger (2026-08-09): harness-agent-run's claude arm must record the
    # round's own token anatomy (advisory — exit code always the round's, narrative always
    # surfaced, row only on a well-formed payload). Hermetic via CLAUDE_BIN stubs.
    rul = os.path.join(root, "tests", "round-usage-ledger", "run.py")
    if os.path.isfile(rul):
        try:
            r = subprocess.run([sys.executable, rul], capture_output=True, text=True, timeout=120)
            if r.returncode != 0:
                tail = (r.stdout + "\n" + r.stderr).strip().splitlines()[-6:]
                err("tests/round-usage-ledger", "cost-ledger contract failed: " + " | ".join(tail))
        except Exception as ex:
            err("tests/round-usage-ledger", f"cost-ledger contract could not run: {ex}")
    else:
        err("tests/round-usage-ledger", "contract file missing (run.py) — the round cost "
                                        "ledger is unverified")

    # session-log's load-bearing contracts: prepend/archive-roll/WIP-overwrite + the check gate.
    fn_contract("session-log", session_log_behavior_ok, "bin/session-log",
                ("bin/session-log",))

    # loop-tick's watcher must persistence-gate reds: a transient harness-verify red must not
    # pollute the forward queue (it manufactures a dry round — the loop's core reward-hack risk).
    fn_contract("loop-tick-persistence", loop_tick_persistence_ok,
                "bin/loop-tick", ("bin/loop-tick",))

    # loop-tick's research intake must hard-cap open leads + keep the anchored arXiv query:
    # an unbounded/off-domain intake pins the fire-gate at ACT and drowns real watcher signal.
    fn_contract("loop-tick-backpressure", loop_tick_backpressure_ok,
                "bin/loop-tick", ("bin/loop-tick", "bin/harness-scan"))

    # ...and the drain side must stay WIRED: an inflow cap with no residence bound deadlocks
    # intake silently (three weeks of it went unnoticed with this guard green — lq-8962bc1c).
    fn_contract("loop-tick-ttl-wired", loop_tick_ttl_wired_ok,
                "bin/loop-tick", ("bin/loop-tick", "bin/loop-queue"))

    # Safe experiments and context policy stay gated by offline/proposal-only contracts.
    # These make no network calls and mutate only disposable fixture homes.
    for contract_id, rel, where, timeout_seconds in (

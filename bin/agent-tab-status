#!/usr/bin/env bash
# Set the Warp-visible tmux window title for Claude/Codex lifecycle state.
# Hooks call this with the current TMUX_PANE. Launchers may pass an explicit
# pane id as argv[2] immediately after creating a detached session.
set -uo pipefail

state="${1:-}"
pane="${2:-${TMUX_PANE:-}}"

case "$state" in
  idle)      marker='○' ;;
  working)   marker='…' ;;
  attention) marker='!!!' ;;
  *)
    printf 'usage: agent-tab-status {idle|working|attention} [%%pane-id]\n' >&2
    exit 2
    ;;
esac

# Hooks also run in headless/non-tmux contexts. Those are successful no-ops.
[[ "$pane" =~ ^%[0-9]+$ ]] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

session="$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null)" || exit 0
case "$session" in
  claude-*)   base="${session#claude-}" ;;
  codex-*)    base="${session#codex-}" ;;
  opencode-*) base="${session#opencode-}" ;;
  *) exit 0 ;;
esac

# Keep terminal control bytes and tmux punctuation out of the OSC title. A
# session created with an odd name still gets a stable, printable label.
base="$(LC_ALL=C printf '%s' "$base" | tr -c '[:alnum:]_. -' ' ' | tr -s ' ' | sed -E 's/^ +//; s/ +$//' | cut -c1-64)"
[[ -n "$base" ]] || base='session'
title="$marker $base"

# Disable both automatic process-name updates and application-issued rename
# escapes for this one window. tmux's global set-titles setting propagates #W
# to Warp through OSC 0.
tmux set-option -w -t "$pane" automatic-rename off >/dev/null 2>&1 || exit 0
tmux set-option -w -t "$pane" allow-rename off >/dev/null 2>&1 || exit 0
tmux rename-window -t "$pane" "$title" >/dev/null 2>&1 || exit 0
exit 0

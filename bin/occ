#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# occ — hardened one-shot `opencode run` for fire-and-forget delegation.
#
# opencode 1.17.x intermittently hangs at startup (between `init` and
# session-create — before the banner, independent of prompt/model/MCP; see
# loop-queue lq-6e4c38c5). A hung run never recovers, and killing it orphans
# the MCP child processes it spawned (e.g. hermes mcp_server.py). This wrapper
# makes the delegation pattern safe:
#   • timeout      — bound each attempt (default 120s; healthy runs take ~10s)
#   • retry        — re-dispatch after a timeout (default 1 retry); real
#                    (non-timeout) failures surface immediately, never retried
#   • orphan-reap  — each attempt runs in its own process group, so a timeout
#                    kills opencode AND its MCP children; pre-existing orphans
#                    (ppid 1) from earlier kills are reaped best-effort
#
# Usage:
#   occ "<prompt>"                          # default agent: glm-coder
#   occ "<prompt>" --agent kimi-coder
#   occ "<prompt>" --timeout 300 --retries 2
#   occ "<prompt>" --final-output           # terminal assistant text only
#
# Exit: opencode's own exit code; 124 if every attempt timed out.
# Env: OPENCODE_BIN to override the opencode binary.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail
export ORCHESTRATORMAXXING_HARNESS_CHILD=1

AGENT="glm-coder"
TIMEOUT=120
RETRIES=1
PROMPT=""
FINAL_OUTPUT=0
CAPTURE=""
ERR_CAPTURE=""

usage(){ sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --agent)   AGENT="${2:?--agent needs a value}"; shift 2 ;;
    --timeout) TIMEOUT="${2:?--timeout needs seconds}"; shift 2 ;;
    --retries) RETRIES="${2:?--retries needs a count}"; shift 2 ;;
    --final-output) FINAL_OUTPUT=1; shift ;;
    -h|--help) usage ;;
    -*)        echo "occ: unknown flag $1" >&2; usage 2 ;;
    *)         if [ -z "$PROMPT" ]; then PROMPT="$1"; shift
               else echo "occ: only one prompt argument allowed" >&2; usage 2; fi ;;
  esac
done
[ -n "$PROMPT" ] || { echo "occ: no prompt given" >&2; usage 2; }

OC="${OPENCODE_BIN:-}"
if [ -z "$OC" ]; then
  OC="$(command -v opencode || true)"
  [ -n "$OC" ] || OC="$HOME/.opencode/bin/opencode"
fi
[ -x "$OC" ] || { echo "occ: opencode binary not found (set OPENCODE_BIN)" >&2; exit 127; }

cleanup_captures(){
  [ -z "$CAPTURE" ] || [ ! -f "$CAPTURE" ] || rm -f -- "$CAPTURE"
  [ -z "$ERR_CAPTURE" ] || [ ! -f "$ERR_CAPTURE" ] || rm -f -- "$ERR_CAPTURE"
}

if [ "$FINAL_OUTPUT" -eq 1 ]; then
  CAPTURE="$(mktemp "${TMPDIR:-/tmp}/occ-final-output.XXXXXX")" || exit 1
  ERR_CAPTURE="$(mktemp "${TMPDIR:-/tmp}/occ-final-error.XXXXXX")" || {
    cleanup_captures
    exit 1
  }
  trap cleanup_captures EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
fi

# Reap orphaned hermes MCP servers left by previously killed opencode runs.
# Heuristic: reparented to init (ppid 1) + the orchestrator mcp_server.py cmdline.
# Never matches the hermes-agent watchdog chain (its ppid is the watchdog).
reap_orphans(){
  ps -eo pid=,ppid=,args= 2>/dev/null \
    | awk '$2==1 && /orchestrator\/mcp_server[.]py/ && !/mcp_stdio_watchdog/ {print $1}' \
    | while read -r p; do
        kill "$p" 2>/dev/null && echo "occ: reaped orphan mcp_server (pid $p)" >&2
      done
}

# One attempt in its own process group (set -m), so a timeout kill takes the
# whole tree — opencode plus any MCP children — leaving no fresh orphans.
run_once(){
  set -m
  if [ "$FINAL_OUTPUT" -eq 1 ]; then
    : >"$CAPTURE"
    : >"$ERR_CAPTURE"
    "$OC" run --pure --format json --agent "$AGENT" "$PROMPT" \
      >"$CAPTURE" 2>"$ERR_CAPTURE" &
  else
    "$OC" run --agent "$AGENT" "$PROMPT" &
  fi
  local pid=$!
  set +m
  local waited=0
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt "$TIMEOUT" ]; do
    sleep 1; waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null
    sleep 2
    kill -KILL -- "-$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    return 124
  fi
  wait "$pid"
}

emit_final_output(){
  python3 - "$CAPTURE" <<'PY'
import json
import os
import sys

TOTAL_LIMIT = 8 * 1024 * 1024
LINE_LIMIT = 1024 * 1024
TEXT_LIMIT = 1024 * 1024
ALLOWED = {"step_start", "tool_use", "text", "reasoning", "step_finish", "error"}


class Rejected(Exception):
    pass


def reject(kind):
    raise Rejected(kind)


path = sys.argv[1]
try:
    size = os.stat(path).st_size
    if size > TOTAL_LIMIT:
        reject("stream-too-large")
    raw_lines = []
    with open(path, "rb") as source:
        while True:
            raw = source.readline(LINE_LIMIT + 1)
            if not raw:
                break
            if len(raw) > LINE_LIMIT:
                reject("event-line-too-large")
            raw_lines.append(raw)
except OSError:
    print("occ: final-output rejected: unreadable-stream", file=sys.stderr)
    raise SystemExit(65)
except Rejected as exc:
    print(f"occ: final-output rejected: {exc}", file=sys.stderr)
    raise SystemExit(65)

steps = {}
sessions = set()
finished_order = []
candidates = []

try:
    if not raw_lines:
        reject("empty-stream")
    for raw in raw_lines:
        try:
            line = raw.decode("utf-8").rstrip("\r\n")
            event = json.loads(line)
        except (UnicodeDecodeError, json.JSONDecodeError):
            reject("malformed-event")
        if not isinstance(event, dict) or event.get("type") not in ALLOWED:
            reject("unknown-event")
        kind = event["type"]
        if kind == "error":
            reject("error-event")
        session_id = event.get("sessionID")
        part = event.get("part")
        if not isinstance(session_id, str) or not session_id or not isinstance(part, dict):
            reject("invalid-shape")
        if part.get("sessionID") != session_id:
            reject("mixed-session")
        sessions.add(session_id)
        if len(sessions) != 1:
            reject("mixed-session")
        message_id = part.get("messageID")
        if not isinstance(message_id, str) or not message_id:
            reject("invalid-shape")

        if kind == "step_start":
            if part.get("type") != "step-start" or message_id in steps:
                reject("invalid-step")
            steps[message_id] = {"open": True, "texts": [], "tool": False}
            continue

        step = steps.get(message_id)
        if not step or not step["open"]:
            reject("unpaired-event")
        if kind == "text":
            text = part.get("text")
            if part.get("type") != "text" or not isinstance(text, str):
                reject("invalid-text")
            step["texts"].append(text)
        elif kind == "tool_use":
            if part.get("type") != "tool":
                reject("invalid-tool")
            step["tool"] = True
        elif kind == "reasoning":
            if part.get("type") != "reasoning":
                reject("invalid-reasoning")
        elif kind == "step_finish":
            if part.get("type") != "step-finish" or not isinstance(part.get("reason"), str):
                reject("invalid-finish")
            step["open"] = False
            finished_order.append(message_id)
            if part["reason"] == "stop":
                if step["tool"] or len(step["texts"]) != 1 or not step["texts"][0].strip():
                    reject("ambiguous-final-text")
                candidates.append((message_id, step["texts"][0]))

    if any(step["open"] for step in steps.values()):
        reject("incomplete-step")
    if len(candidates) != 1 or not finished_order or candidates[0][0] != finished_order[-1]:
        reject("ambiguous-terminal-step")
    text = candidates[0][1]
    if len(text.encode("utf-8")) > TEXT_LIMIT:
        reject("final-text-too-large")
except Rejected as exc:
    print(f"occ: final-output rejected: {exc}", file=sys.stderr)
    raise SystemExit(65)

sys.stdout.write(text.rstrip("\r\n") + "\n")
PY
}

reap_orphans
attempt=1
while :; do
  run_once; rc=$?
  if [ "$rc" -ne 124 ]; then
    if [ "$rc" -ne 0 ]; then
      if [ "$FINAL_OUTPUT" -eq 1 ]; then
        echo "occ: opencode failed (exit $rc)" >&2
      fi
      exit "$rc"
    fi
    if [ "$FINAL_OUTPUT" -eq 1 ]; then
      emit_final_output
      exit $?
    fi
    exit 0
  fi
  reap_orphans
  if [ "$attempt" -gt "$RETRIES" ]; then
    echo "occ: gave up — $attempt attempt(s) timed out after ${TIMEOUT}s each" >&2
    exit 124
  fi
  echo "occ: attempt $attempt timed out after ${TIMEOUT}s — retrying" >&2
  attempt=$((attempt + 1))
done

#!/usr/bin/env python3
"""Run identical contract cases through argv-based worker adapters."""
import argparse
import json
import math
import os
import selectors
import shlex
import signal
import subprocess
import sys
import time
HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
repo_score = os.path.join(REPO, 'experiments', 'worker-path-bench')
installed_score = os.path.expanduser('~/.local/share/orchestratormaxxing/worker-path-bench')
sys.path.insert(0, repo_score if os.path.isfile(os.path.join(repo_score, 'score.py')) else installed_score)
from score import compute_summary, parse_envelope, score_contract

def parse_adapter(spec):
    if '=' not in spec:
        raise ValueError(f'adapter must be NAME=COMMAND: {spec!r}')
    name, command = spec.split('=', 1)
    argv = shlex.split(command)
    if not name.strip() or not argv:
        raise ValueError(f'invalid adapter: {spec!r}')
    return (name.strip(), argv)

def _kill_group(proc, sig):
    try:
        os.killpg(proc.pid, sig)
    except (ProcessLookupError, PermissionError):
        pass


def _terminate_process_tree(proc):
    # The leader can exit before a descendant closes its pipes. Always signal the
    # process group, including after wait() has reaped the leader.
    # Defer cancellation while completing cleanup. A signal during the grace
    # period must not skip SIGKILL for a resistant descendant.
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM})
    try:
        _kill_group(proc, signal.SIGTERM)
        time.sleep(0.05)
        _kill_group(proc, signal.SIGKILL)
        proc.wait(timeout=1)
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous)



def _validate_timeout(value):
    """Return a finite, positive float timeout_seconds or raise ValueError."""
    if value is None:
        return 30.0
    if isinstance(value, bool):
        raise ValueError(f'timeout_seconds must be a positive finite number: {value!r}')
    if isinstance(value, (int, float)):
        t = float(value)
        if math.isfinite(t) and t > 0:
            return t
    if isinstance(value, str):
        try:
            t = float(value)
            if math.isfinite(t) and t > 0:
                return t
        except ValueError:
            pass
    raise ValueError(f'timeout_seconds must be a positive finite number: {value!r}')

def adapter_payload(case):
    """Return the subset of a case that an adapter may see.

    Excludes verifier-only data: the contract answer, expected value, and any
    field whose key starts with `verifier_`. Adapters must never receive the
    expected answer or any secrets needed only by the verifier.
    """
    drop = {'answer', 'contract', 'expected'}
    return {k: v for k, v in case.items() if k not in drop and (not k.startswith('verifier_'))}

def _parse_event_value(value, kind):
    if value is None:
        return None
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        v = float(value)
        if math.isfinite(v) and v >= 0:
            return v
        return None
    if isinstance(value, str):
        try:
            v = float(value)
            if math.isfinite(v) and v >= 0:
                return v
        except ValueError:
            pass
    return None


def _extract_event_metrics(events):
    if not isinstance(events, list):
        raise ValueError('events must be a list')
    compaction_count = 0
    cache_read_tokens = None
    for event in events or []:
        if not isinstance(event, dict):
            raise ValueError('every event must be an object')
        if event.get('type') == 'compaction':
            compaction_count += 1
        parsed = _parse_event_value(event.get('cache_read_tokens'), 'cache_read_tokens')
        if parsed is not None:
            cache_read_tokens = (cache_read_tokens or 0) + parsed
        if 'cache_read_tokens' in event and parsed is None:
            raise ValueError(f'invalid cache_read_tokens value: {event.get("cache_read_tokens")!r}')
    return (compaction_count, cache_read_tokens)

def run_case(name, argv, case, output_limit=1048576):
    started = time.monotonic()
    timeout = _validate_timeout(case.get('timeout_seconds'))
    timed_out = False
    output_limit_exceeded = False
    exit_code = None
    stdout = ''
    stderr = ''
    proc = None
    chunks = {"stdout": bytearray(), "stderr": bytearray()}
    try:
        payload = memoryview(json.dumps(adapter_payload(case)).encode("utf-8"))
        deadline = started + timeout
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, start_new_session=True)
        with selectors.DefaultSelector() as selector:
            for stream, event, label in ((proc.stdin, selectors.EVENT_WRITE, "stdin"),
                                         (proc.stdout, selectors.EVENT_READ, "stdout"),
                                         (proc.stderr, selectors.EVENT_READ, "stderr")):
                os.set_blocking(stream.fileno(), False)
                selector.register(stream, event, label)
            offset = total = 0
            while selector.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    timed_out = True
                    break
                for key, _ in selector.select(min(remaining, 0.05)):
                    stream, label = key.fileobj, key.data
                    if label == "stdin":
                        try:
                            offset += os.write(stream.fileno(), payload[offset:offset + 65536])
                        except BlockingIOError:
                            continue
                        except BrokenPipeError:
                            offset = len(payload)
                        if offset == len(payload):
                            selector.unregister(stream)
                            stream.close()
                    else:
                        try:
                            chunk = os.read(stream.fileno(), 65536)
                        except BlockingIOError:
                            continue
                        if not chunk:
                            selector.unregister(stream)
                            stream.close()
                            continue
                        # Retain at most the combined byte budget, not one budget
                        # per stream. Still notice the first byte beyond the cap.
                        kept = chunk[:max(0, output_limit - total)]
                        chunks[label].extend(kept)
                        total += len(chunk)
                        if total > output_limit:
                            output_limit_exceeded = True
                            break
                if output_limit_exceeded:
                    break
            if not timed_out and not output_limit_exceeded:
                try:
                    proc.wait(timeout=max(0, deadline - time.monotonic()))
                except subprocess.TimeoutExpired:
                    timed_out = True
    except (OSError, ValueError) as exc:
        stderr = f"{type(exc).__name__}: {exc}"
    finally:
        if proc is not None:
            _terminate_process_tree(proc)
            exit_code = proc.returncode
            for stream in (proc.stdin, proc.stdout, proc.stderr):
                if not stream.closed:
                    stream.close()
        stdout = chunks["stdout"].decode("utf-8", "replace")
        stderr += chunks["stderr"].decode("utf-8", "replace")
    envelope, schema_valid = parse_envelope(stdout)
    infrastructure_failure = (
        timed_out
        or exit_code != 0
        or (not schema_valid)
        or output_limit_exceeded
    )
    output = envelope.get('output') if envelope else None
    contract = case.get('contract', {})
    usage = envelope.get('usage', {}) if envelope else {}
    events = envelope.get('events', []) if envelope else []
    try:
        compaction_count, cache_read_tokens = _extract_event_metrics(events)
    except Exception as exc:
        infrastructure_failure = True
        stderr = (stderr or '') + f'\nevent-metrics-error: {type(exc).__name__}: {exc}'
        stderr = stderr.strip()
        compaction_count = None
        cache_read_tokens = None
    if not envelope or 'events' not in envelope:
        compaction_count = None
    result = {
        'adapter': name, 'case_id': case.get('id'),
        'contract_type': contract.get('type'), 'expected': contract.get('expected'),
        'output': output, 'usage': usage, 'events': events,
        'schema_valid': schema_valid,
        'infrastructure_failure': infrastructure_failure,
        'timed_out': timed_out,
        'exit_code': exit_code,
        'contract_pass': False if infrastructure_failure else score_contract(contract, output),
        'latency_ms': round((time.monotonic() - started) * 1000, 3),
        'stderr': stderr[:4096],
        'output_limit_exceeded': output_limit_exceeded,
    }
    if 'target_input_tokens' in case:
        result['target_input_tokens'] = case['target_input_tokens']
    if 'estimated_input_tokens' in case:
        result['estimated_input_tokens'] = case['estimated_input_tokens']
    if 'canary_kind' in case:
        result['canary_kind'] = case['canary_kind']
    if 'needle_position' in case:
        result['needle_position'] = case['needle_position']
    result['protected_fact'] = case.get('protected_fact')
    result['protected_fact_pass'] = output == contract.get('expected') if case.get('protected_fact') else None
    result['input_tokens_proxy'] = case.get('target_input_tokens')
    result['input_tokens_actual'] = usage.get('prompt_tokens')
    result['compaction_count'] = compaction_count
    result['cache_read_tokens'] = cache_read_tokens
    return result

def load_cases(path):
    with open(path, encoding='utf-8') as handle:
        cases = [json.loads(line) for line in handle if line.strip()]
    if not cases:
        raise ValueError('cases file is empty')
    for case in cases:
        if not isinstance(case, dict) or not isinstance(case.get('id'), str) or (not case['id']):
            raise ValueError('every case needs a non-empty string id')
        _validate_timeout(case.get('timeout_seconds'))
        contract = case.get('contract')
        if not isinstance(contract, dict) or contract.get('type') not in {'exact', 'json_fields'} or 'expected' not in contract:
            raise ValueError(f"case {case['id']!r} needs a supported contract and expected value")
        if contract['type'] == 'json_fields' and (not isinstance(contract['expected'], dict) or not contract['expected']):
            raise ValueError('json_fields requires a nonempty expected object')
        for field in ('target_input_tokens', 'estimated_input_tokens'):
            if field in case and (not isinstance(case[field], int) or isinstance(case[field], bool) or case[field] < 0):
                raise ValueError(f'{field} must be a nonnegative integer')
    if len({case['id'] for case in cases}) != len(cases):
        raise ValueError('case IDs must be unique')
    return cases

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--cases', required=True)
    parser.add_argument('--adapter', action='append', required=True)
    parser.add_argument('--output', required=True)
    parser.add_argument('--summary', required=True)
    args = parser.parse_args()
    try:
        adapters = [parse_adapter(spec) for spec in args.adapter]
        if len({name for name, _ in adapters}) != len(adapters):
            raise ValueError('adapter names must be unique')
        cases = load_cases(args.cases)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f'worker-path-bench: {exc}', file=sys.stderr)
        return 2
    results = [run_case(name, argv, case) for name, argv in adapters for case in cases]
    results.sort(key=lambda row: (str(row['adapter']), str(row['case_id'] or '')))
    try:
        with open(args.output, 'w', encoding='utf-8') as handle:
            for row in results:
                handle.write(json.dumps(row, sort_keys=True) + '\n')
        with open(args.summary, 'w', encoding='utf-8') as handle:
            json.dump(compute_summary(results), handle, sort_keys=True, indent=2)
            handle.write('\n')
    except OSError as exc:
        print(f'worker-path-bench: {exc}', file=sys.stderr)
        return 2
    return 0
if __name__ == '__main__':
    def cancel(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, cancel)
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)

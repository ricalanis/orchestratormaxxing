#!/usr/bin/env python3
"""One fail-open Codex Stop hook with exactly one JSON object on stdout."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def _run(
    argv: list[str], *, capture: bool = False, timeout: int = 12
) -> str:
    if not argv or not shutil.which(argv[0]):
        return ""
    try:
        result = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip() if capture and result.returncode == 0 else ""


def _session_name() -> str:
    tmux = shutil.which("tmux")
    if not tmux or not os.environ.get("TMUX"):
        return "session"
    value = _run([tmux, "display-message", "-p", "#{session_name}"], capture=True, timeout=2)
    return value[:96] if value else "session"


def _notification_script() -> str | None:
    path = Path.home() / ".hermes" / "scripts" / "notify-code-thread.sh"
    return str(path) if path.is_file() and os.access(path, os.X_OK) else None


def _run_notifier(path: str, payload: bytes) -> None:
    try:
        subprocess.run(
            [path, "--agent", "codex"],
            input=payload,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=12,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def main() -> int:
    # The raw payload may reach only the notifier; it must never be reflected in
    # the hook's stdout object or lifecycle signals.
    try:
        raw_payload = sys.stdin.buffer.read()
    except OSError:
        raw_payload = b""

    if os.environ.get("SOLPLAN_CHILD") == "1":
        print("{}")
        return 0

    _run(["agent-tab-status", "attention"], timeout=4)
    _run(["warp-agent-event", "codex", "stop"], timeout=4)

    messages: list[str] = []
    memory = _run(["mem-audit"], capture=True)
    if "⚠" in memory or "✗" in memory:
        messages.append("Shared memory needs attention:\n" + memory[:3000])
    session_log = _run(["session-log", "check"], capture=True)
    if session_log:
        messages.append(session_log[:3000])

    notifier = shutil.which("agent-done-notify")
    if notifier:
        _run_notifier(notifier, raw_payload)
    else:
        notify = _notification_script()
        if notify:
            _run([notify, "codex", _session_name(), "Session completed"], timeout=12)

    output: dict[str, str] = {}
    if messages:
        output["systemMessage"] = "\n\n".join(messages)[:6000]
    print(json.dumps(output, ensure_ascii=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
